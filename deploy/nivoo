#!/usr/bin/env bash
# Nivoo AI Manager — comando de administração do servidor (instalado em /usr/local/bin/nivoo).
set -euo pipefail

APP_DIR=/opt/nivoo/app
NODE_DIR=/opt/nivoo/node
NIVOO_USER=nivoo
NIVOO_HOME=/var/lib/nivoo
ENV_FILE=/etc/nivoo/nivoo.env
BACKUP_DIR=/var/backups/nivoo

[ "$(id -u)" = 0 ] || { echo "execute como root" >&2; exit 1; }
umask 077  # backups e arquivos gerados nunca legíveis por outros usuários
export PATH="$NODE_DIR/bin:$PATH"
PORT="$(sed -n 's/^PORT=//p' "$ENV_FILE" 2>/dev/null || true)"; PORT="${PORT:-3000}"
TOKEN="$(sed -n 's/^NIVOO_API_TOKEN=//p' "$ENV_FILE" 2>/dev/null || true)"
API="http://127.0.0.1:$PORT/api"

as_nivoo() { runuser -u "$NIVOO_USER" -- env HOME="$NIVOO_HOME" PATH="$NODE_DIR/bin:/usr/local/bin:/usr/bin:/bin" "$@"; }
api() { curl -fsS ${TOKEN:+-H "Authorization: Bearer $TOKEN"} -X "${2:-GET}" "$API$1"; }
json() { "$NODE_DIR/bin/node" -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const j=JSON.parse(d);($1)(j)})"; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  status)
    systemctl --no-pager --lines=0 status nivoo-api nivoo-worker postgresql || true
    ;;
  logs)
    # nivoo logs [api|worker]   (Ctrl+C para sair)
    svc="${1:-}"; if [ -n "$svc" ]; then journalctl -u "nivoo-$svc" -f -n 100; else journalctl -u nivoo-api -u nivoo-worker -f -n 100; fi
    ;;
  start|stop|restart)
    systemctl "$cmd" nivoo-api nivoo-worker
    echo "ok: $cmd"
    ;;
  login-claude)
    echo "Login OFICIAL do Claude Code para o usuário do worker ($NIVOO_USER)."
    echo "Siga as instruções na tela (abra o link no navegador do seu computador e cole o código)."
    echo "Ao terminar, digite /exit para sair do Claude Code."
    cd "$NIVOO_HOME"
    as_nivoo claude
    as_nivoo claude auth status || true
    systemctl restart nivoo-api nivoo-worker
    ;;
  set-claude-token)
    # Alternativa sem navegador: gere o token oficial em qualquer máquina com 'claude setup-token'.
    tok="${1:-}"; [ -n "$tok" ] || { read -rsp "Cole o token (CLAUDE_CODE_OAUTH_TOKEN): " tok; echo; }
    sed -i '/^#\? *CLAUDE_CODE_OAUTH_TOKEN=/d' "$ENV_FILE"
    echo "CLAUDE_CODE_OAUTH_TOKEN=$tok" >> "$ENV_FILE"
    systemctl restart nivoo-api nivoo-worker
    echo "ok: token gravado em $ENV_FILE (permissão 640); API e worker reiniciados"
    ;;
  login-codex)
    echo "Login OFICIAL do Codex por código de dispositivo para o usuário do worker ($NIVOO_USER)."
    cd "$NIVOO_HOME"
    as_nivoo codex login --device-auth
    as_nivoo codex login status || true
    systemctl restart nivoo-api nivoo-worker
    ;;
  check)
    echo "== serviços"; systemctl is-active nivoo-api nivoo-worker postgresql | paste -sd' ' -
    echo "== API"; api /health && echo
    echo "== workers"; api /system/workers | json 'j=>j.forEach(w=>console.log(`  ${w.id}  ${w.online?"online":"offline"}  último sinal ${w.lastSeenAt}`))'
    echo "== conectores (vistos pelo usuário $NIVOO_USER)"
    for p in claude-code-cli claude-api codex-cli codex-api gemini-api gemini-video local-shell; do
      api "/providers/$p/check" POST | json 'j=>console.log(`  ${j.id.padEnd(16)} ${j.available?"DISPONÍVEL":"indisponível"}  ${j.version??""}  ${j.errors.join("; ")}`)'
    done
    echo "   (o worker roda como $NIVOO_USER; a API também — os logins acima valem para os dois)"
    ;;
  update)
    cd "$APP_DIR"
    if [ -d .git ]; then
      git pull --ff-only
    else
      echo "código sem .git: substitua os arquivos em $APP_DIR pela nova versão e rode 'nivoo update' de novo" >&2
    fi
    nivoo backup
    (umask 022; bash "$APP_DIR/deploy/install-debian.sh")
    ;;
  backup)
    install -d -m 700 "$BACKUP_DIR"
    ts="$(date +%Y%m%d-%H%M%S)"
    runuser -u postgres -- pg_dump -Fc nivoo > "$BACKUP_DIR/nivoo-db-$ts.dump"
    tar -C "$NIVOO_HOME" -czf "$BACKUP_DIR/nivoo-data-$ts.tar.gz" data
    cp "$ENV_FILE" "$BACKUP_DIR/nivoo-env-$ts" && chmod 600 "$BACKUP_DIR/nivoo-env-$ts"
    ls -lh "$BACKUP_DIR"/*"$ts"*
    ;;
  restore)
    # nivoo restore <carimbo>   ex.: nivoo restore 20261028-101500
    ts="${1:?informe o carimbo do backup (veja ls $BACKUP_DIR)}"
    read -rp "Isto SUBSTITUI o banco e os dados atuais pelo backup $ts. Digite SIM para continuar: " ans
    [ "$ans" = SIM ] || { echo "cancelado"; exit 1; }
    [ -f "$BACKUP_DIR/nivoo-db-$ts.dump" ] && [ -f "$BACKUP_DIR/nivoo-data-$ts.tar.gz" ] || { echo "backup $ts incompleto ou inexistente" >&2; exit 1; }
    systemctl stop nivoo-api nivoo-worker
    trap 'systemctl start nivoo-api nivoo-worker' EXIT   # os serviços voltam mesmo se a restauração falhar
    # O arquivo é do root (600): o root o lê e entrega pela entrada padrão ao pg_restore (usuário postgres).
    runuser -u postgres -- pg_restore --clean --if-exists -d nivoo < "$BACKUP_DIR/nivoo-db-$ts.dump"
    rm -rf "$NIVOO_HOME/data" && tar -C "$NIVOO_HOME" -xzf "$BACKUP_DIR/nivoo-data-$ts.tar.gz"
    chown -R "$NIVOO_USER:$NIVOO_USER" "$NIVOO_HOME/data"
    echo "ok: restaurado"
    ;;
  diagnostico)
    # Relatório para o suporte: estado do sistema (versão, worker, fila, IAs, trabalhos parados, erros registrados)
    # + avisos e erros recentes dos serviços. Sem segredos. Salvo em /root para anexar.
    arq="/root/nivoo-diagnostico-$(date +%Y%m%d-%H%M%S).md"
    {
      curl -fsS --max-time 60 ${TOKEN:+-H "Authorization: Bearer $TOKEN"} "$API/system/diagnostico" || echo "# A API não respondeu ao diagnóstico (nivoo status / nivoo logs api)"
      echo; echo "## Serviços"; echo '```'
      systemctl --no-pager --lines=0 status nivoo-api nivoo-worker 2>&1 | grep -E '●|Active:' || true
      echo '```'; echo; echo "## Avisos e erros recentes dos serviços (journal)"; echo '```'
      journalctl -u nivoo-api -u nivoo-worker -p warning -n 120 --no-pager 2>/dev/null \
        | sed -E 's/(sk-ant-[A-Za-z0-9_-]{6})[A-Za-z0-9_-]+/\1…[oculto]/g; s/(Bearer )[A-Za-z0-9._~+\/=-]+/\1[oculto]/g; s/(postgres(ql)?:\/\/[^:]+:)[^@]+@/\1[oculto]@/g' || true
      echo '```'
    } > "$arq"
    chmod 600 "$arq"
    cat "$arq"
    echo
    echo "== salvo em $arq (mande este arquivo ou o texto acima para o suporte)"
    ;;
  testar-chatgpt)
    # Teste real do ChatGPT (Codex) como o worker usa: lê um arquivo pelo terminal dentro do isolamento dele.
    # Mostra se o login, o isolamento (sandbox) e a leitura funcionam neste servidor. Custa uma resposta curta.
    dir="$(runuser -u "$NIVOO_USER" -- mktemp -d)"
    palavra="nivoo-$(date +%s)"
    runuser -u "$NIVOO_USER" -- sh -c "echo '$palavra' > '$dir/teste.txt'"
    echo "== pedindo ao ChatGPT para ler $dir/teste.txt com o terminal (sandbox workspace-write)…"
    saida="$(cd "$dir" && runuser -u "$NIVOO_USER" -- env HOME="$NIVOO_HOME" PATH="$NODE_DIR/bin:/usr/local/bin:/usr/bin:/bin" \
      codex exec --json --sandbox workspace-write --skip-git-repo-check -C "$dir" \
      "Rode no terminal: cat teste.txt — e responda só com o conteúdo do arquivo." 2>&1 || true)"
    rm -rf "$dir"
    if printf '%s' "$saida" | grep -q "\"type\":\"agent_message\".*$palavra"; then
      echo "OK: o ChatGPT leu o arquivo pelo terminal. Ele consegue trabalhar nos projetos."
    else
      echo "FALHOU: o ChatGPT não conseguiu ler o arquivo. Trecho da resposta (mande para o suporte):"
      printf '%s\n' "$saida" | grep -E 'command_execution|agent_message|error|bwrap|sandbox|denied|login' | tail -15 | cut -c1-400
    fi
    ;;
  verificar)
    # Job de ponta a ponta (sem IA) para confirmar que API, worker, banco e workspaces funcionam.
    bash "$APP_DIR/deploy/verificar-instalacao.sh" "$API"
    ;;
  tunnel)
    ip="$(hostname -I | awk '{print $1}')"
    echo "No SEU computador:  ssh -N -L $PORT:127.0.0.1:$PORT root@$ip"
    echo "Depois abra:        http://localhost:$PORT"
    ;;
  dominio)
    # nivoo dominio nivoo.suaempresa.com.br  → publica o Nivoo nesse endereço pela Cloudflare (Cloudflare Tunnel)
    # nivoo dominio status                   → mostra o túnel e testa o endereço
    # nivoo dominio remover                  → desliga o túnel (o Nivoo volta a ser só local)
    # O Nivoo continua ouvindo só em 127.0.0.1: o cloudflared liga PARA FORA, até a Cloudflare.
    # Nenhuma porta é aberta no servidor, e o HTTPS é da Cloudflare.
    CF_DIR=/etc/cloudflared
    TUNEL="nivoo-$(hostname -s)"
    sub="${1:-}"
    case "$sub" in
      ""|-h|--help)
        echo "uso: nivoo dominio <endereço>   ex.: nivoo dominio nivoo.suaempresa.com.br"
        echo "     nivoo dominio acesso <equipe> <aud>   (login da Cloudflare dispensa o token)"
        echo "     nivoo dominio status | nivoo dominio remover"
        exit 1
        ;;
      status)
        systemctl --no-pager --lines=0 status cloudflared || true
        host=""
        [ -f "$CF_DIR/config.yml" ] && host="$(sed -n 's/^ *- hostname: *//p' "$CF_DIR/config.yml" | head -1 || true)"
        if [ -n "$host" ]; then
          code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 20 "https://$host/api/health" || true)"
          echo "endereço: https://$host  (resposta: ${code:-sem resposta}; 200 = aberto só com o token, 302/403 = protegido pelo Cloudflare Access)"
        else
          echo "nenhum domínio configurado (use: nivoo dominio <endereço>)"
        fi
        ;;
      acesso)
        # nivoo dominio acesso <equipe> <aud>: quem passou pelo login da Cloudflare entra direto (sem token).
        # <equipe>: Zero Trust → Settings → Team domain (ex.: minhaequipe ou minhaequipe.cloudflareaccess.com)
        # <aud>: Access → Applications → (a aplicação do Nivoo) → Application Audience (AUD) Tag
        equipe="${2:-}"; aud="${3:-}"
        if [ -z "$equipe" ] || [ -z "$aud" ]; then
          echo "uso: nivoo dominio acesso <equipe> <aud>"
          echo "  <equipe>: Zero Trust → Settings → Team domain   (ex.: minhaequipe.cloudflareaccess.com)"
          echo "  <aud>:    Access → Applications → aplicação do Nivoo → Application Audience (AUD) Tag"
          exit 1
        fi
        echo "$equipe" | grep -Eq '^[a-z0-9.-]+$' || { echo "equipe inválida: $equipe" >&2; exit 1; }
        echo "$aud" | grep -Eq '^[A-Za-z0-9]{16,128}$' || { echo "AUD inválida: $aud (copie a Application Audience Tag inteira)" >&2; exit 1; }
        host="${equipe%.cloudflareaccess.com}.cloudflareaccess.com"
        curl -fsS --max-time 15 "https://$host/cdn-cgi/access/certs" >/dev/null \
          || { echo "não achei a equipe \"$host\" na Cloudflare (confira o Team domain)" >&2; exit 1; }
        sed -i '/^NIVOO_CF_ACCESS_TEAM=/d; /^NIVOO_CF_ACCESS_AUD=/d' "$ENV_FILE"
        echo "NIVOO_CF_ACCESS_TEAM=$host" >> "$ENV_FILE"
        echo "NIVOO_CF_ACCESS_AUD=$aud" >> "$ENV_FILE"
        systemctl restart nivoo-api nivoo-worker
        echo "ok: quem passar pelo login da Cloudflare ($host) entra no Nivoo sem token."
        echo "O token continua valendo para o acesso pelo túnel SSH."
        ;;
      remover)
        systemctl disable --now cloudflared 2>/dev/null || true
        echo "ok: túnel desligado. O Nivoo voltou a ser só local."
        echo "O registro DNS continua na Cloudflare; apague-o no painel se não for mais usar."
        ;;
      *)
        host="$(echo "$sub" | tr 'A-Z' 'a-z')"
        echo "$host" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$' \
          || { echo "endereço inválido: $sub (ex.: nivoo.suaempresa.com.br, sem https:// e sem barra)" >&2; exit 1; }

        echo "== 1/5 programa oficial da Cloudflare (cloudflared)"
        if ! command -v cloudflared >/dev/null 2>&1; then
          install -d -m 0755 /usr/share/keyrings
          curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /usr/share/keyrings/cloudflare-main.gpg
          chmod 644 /usr/share/keyrings/cloudflare-main.gpg
          echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' > /etc/apt/sources.list.d/cloudflared.list
          chmod 644 /etc/apt/sources.list.d/cloudflared.list
          apt-get update -qq && apt-get install -y -qq cloudflared >/dev/null
        fi
        cloudflared --version

        echo "== 2/5 autorizar este servidor na sua conta da Cloudflare"
        if [ ! -f /root/.cloudflared/cert.pem ]; then
          echo "Vai aparecer um link. Abra no navegador do seu computador, entre na Cloudflare e"
          echo "escolha o domínio de \"$host\". Depois volte aqui (continua sozinho)."
          cloudflared tunnel login
        else
          echo "já autorizado (/root/.cloudflared/cert.pem)"
        fi

        echo "== 3/5 túnel \"$TUNEL\" e endereço $host"
        id="$(cloudflared tunnel list -o json 2>/dev/null | json "j=>{const t=(j||[]).find(x=>x.name==='$TUNEL');if(t)console.log(t.id)}" || true)"
        if [ -z "$id" ]; then
          cloudflared tunnel create "$TUNEL" >/dev/null
          id="$(cloudflared tunnel list -o json | json "j=>{const t=(j||[]).find(x=>x.name==='$TUNEL');if(t)console.log(t.id)}")"
        fi
        [ -n "$id" ] || { echo "não consegui criar/achar o túnel $TUNEL" >&2; exit 1; }
        install -d -m 0755 "$CF_DIR"
        if [ ! -f "/root/.cloudflared/$id.json" ] && [ ! -f "$CF_DIR/$id.json" ]; then
          # Túnel já existia (servidor reinstalado, arquivo apagado): pede de novo a credencial dele.
          cloudflared tunnel token --cred-file "/root/.cloudflared/$id.json" "$TUNEL" >/dev/null 2>&1 || {
            echo "o túnel $TUNEL existe na Cloudflare, mas a credencial dele não está neste servidor." >&2
            echo "apague o túnel (cloudflared tunnel delete $TUNEL) ou atualize o cloudflared e rode de novo." >&2
            exit 1
          }
        fi
        [ -f "/root/.cloudflared/$id.json" ] && install -m 0600 "/root/.cloudflared/$id.json" "$CF_DIR/$id.json"
        cat > "$CF_DIR/config.yml" <<CFG
# Gerado por "nivoo dominio". O Nivoo só ouve em 127.0.0.1; a Cloudflare entrega o HTTPS.
tunnel: $id
credentials-file: $CF_DIR/$id.json
ingress:
  - hostname: $host
    service: http://127.0.0.1:$PORT
  - service: http_status:404
CFG
        chmod 600 "$CF_DIR/config.yml"
        cloudflared tunnel route dns --overwrite-dns "$TUNEL" "$host"

        echo "== 4/5 serviço do túnel (volta sozinho se o servidor reiniciar)"
        if [ ! -f /etc/systemd/system/cloudflared.service ]; then cloudflared service install; fi
        systemctl enable --now cloudflared >/dev/null
        systemctl restart cloudflared

        echo "== 5/5 segunda tranca: token do Nivoo"
        if ! grep -q '^NIVOO_API_TOKEN=.\+' "$ENV_FILE"; then
          sed -i '/^#\? *NIVOO_API_TOKEN=/d' "$ENV_FILE"
          echo "NIVOO_API_TOKEN=$(openssl rand -hex 24)" >> "$ENV_FILE"
          systemctl restart nivoo-api nivoo-worker
          echo "token criado (o navegador pede uma vez; fica guardado nele)"
        else
          echo "token já existia (mantido)"
        fi
        TOKEN="$(sed -n 's/^NIVOO_API_TOKEN=//p' "$ENV_FILE")"

        code=""
        for _ in $(seq 1 30); do
          code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "https://$host/api/health" 2>/dev/null || true)"
          case "$code" in 2*|3*|401|403) break ;; esac
          sleep 3
        done
        echo
        echo "Pronto: https://$host  (resposta: ${code:-sem resposta ainda — o DNS pode levar alguns minutos})"
        echo "Token do Nivoo (o navegador pede uma vez): $TOKEN"
        echo
        echo "IMPORTANTE — ligue o login da Cloudflare na frente (grátis até 50 pessoas):"
        echo "  1. dash.cloudflare.com → Zero Trust → Access → Applications → Add an application → Self-hosted"
        echo "  2. Application domain: $host"
        echo "  3. Policy: Action = Allow; Include = Emails → os e-mails que podem entrar"
        echo "  4. Salve. Ao abrir o endereço, a Cloudflare pede o e-mail e manda um código."
        echo "Sem isso, só o token do Nivoo protege o endereço."
        echo
        echo "Depois de ligar o login da Cloudflare, dispense o token no navegador:"
        echo "  nivoo dominio acesso <equipe> <aud>   (rode sem argumentos para ver onde achar cada um)"
        ;;
    esac
    ;;
  help|*)
    cat <<EOF
nivoo — administração do Nivoo AI Manager

  nivoo status              estado dos serviços (api, worker, postgresql)
  nivoo logs [api|worker]   acompanhar logs ao vivo
  nivoo start|stop|restart  controlar os serviços
  nivoo check               conferir API, workers e conectores de IA
  nivoo verificar           roda um job de teste de ponta a ponta (sem IA)
  nivoo testar-chatgpt      confere se o ChatGPT (Codex) consegue ler arquivos neste servidor
  nivoo diagnostico         relatório para o suporte (sistema, fila, IAs, trabalhos parados e erros, sem segredos)
  nivoo login-claude        login oficial do Claude Code para o worker
  nivoo set-claude-token    alternativa: gravar token de 'claude setup-token'
  nivoo login-codex         login oficial do Codex (código de dispositivo)
  nivoo tunnel              mostra o comando de túnel SSH para abrir a interface
  nivoo dominio <endereço>  publica o Nivoo num domínio seu pela Cloudflare (HTTPS, sem abrir portas)
  nivoo dominio status      mostra o túnel e testa o endereço  (nivoo dominio remover: desliga)
  nivoo dominio acesso <equipe> <aud>   entra direto pelo login da Cloudflare (sem token)
  nivoo backup              backup do banco, dados e configuração em $BACKUP_DIR
  nivoo restore <carimbo>   restaura um backup
  nivoo update              backup + atualiza o código (git pull) + reinstala/migra

Configuração: $ENV_FILE   Código: $APP_DIR   Dados: $NIVOO_HOME/data
EOF
    ;;
esac
