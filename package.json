{
  "name": "nivoo-ai-manager",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/backend", "apps/web"],
  "scripts": {
    "build": "npm run build -w apps/backend && npm run build -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/backend",
    "db:seed": "npm run db:seed -w apps/backend",
    "dev:api": "npm run start:api -w apps/backend",
    "dev:worker": "npm run start:worker -w apps/backend",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm test -w apps/backend"
  }
}
