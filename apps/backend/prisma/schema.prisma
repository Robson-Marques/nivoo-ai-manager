// Nivoo AI Manager
// Fonte da verdade: este banco. Ver docs/ARQUITETURA.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExecStatus {
  PENDENTE
  EXECUTANDO
  AGUARDANDO_RECURSO
  AGUARDANDO_APROVACAO
  BLOQUEADO
  FALHOU
  CONCLUIDO
}

enum AttemptStatus {
  EXECUTANDO
  SUCESSO
  FALHA
  INTERROMPIDA
  RECURSO_INDISPONIVEL
  SESSAO_ENCERRADA // sessão do agente terminou sem completar a etapa (ex.: limite de turnos); continua em nova sessão
}

enum QueueTaskType {
  RUN_STEP
  EVALUATE_JOB
  PLAN_MESSAGE // conversa: a IA lê o projeto e propõe um plano (não executa nada)
}

enum MessageRole {
  USUARIO
  ASSISTENTE
}

enum MessageStatus {
  PENDENTE
  PRONTA
  ERRO
}

enum QueueTaskStatus {
  QUEUED
  RUNNING
  DONE
  CANCELLED
  DEAD
}

enum CriterionKind {
  COMMAND
  FILE_EXISTS
  ARTIFACT_PRESENT
  METRIC_THRESHOLD
  MANUAL_APPROVAL
}

enum CriterionStatus {
  PENDENTE
  APROVADO
  REPROVADO
  AGUARDANDO_APROVACAO
}

enum ApprovalKind {
  CRITERIO_SUBJETIVO
  ACAO_DESTRUTIVA
}

enum ApprovalStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

enum MemoryCategory {
  ESPECIFICACAO
  ARQUITETURA_RESTRICOES
  DECISAO_APROVADA
  EVIDENCIA
  PENDENCIA
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// Base (na interface): o jeito de trabalhar de um tipo de projeto — regras permanentes + pasta de padrões
// (versionada) — compartilhado por todos os seus projetos. Especialização por contexto, não fine-tuning.
model Area {
  id                  String   @id @default(uuid())
  slug                String   @unique
  name                String
  description         String   @default("")
  template            String   @default("generica")
  instructionsVersion Int      @default(1)
  retiredStudioWorkflow Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  instructions AreaInstruction[]
  projects     Project[]
}

// Instruções permanentes da área: append-only, versionadas, com hash (como o objetivo de um job).
model AreaInstruction {
  id        String   @id @default(uuid())
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  version   Int
  text      String
  sha256    String
  author    String
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@unique([areaId, version])
}

// Regras do projeto ("fine-tune do projeto"): append-only, versionadas, com hash. Somam-se às regras da
// base e entram em toda conversa e todo trabalho; a conferência automática cobra o cumprimento.
model ProjectRule {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int
  text      String
  sha256    String
  author    String
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@unique([projectId, version])
}

model Conversation {
  id         String    @id @default(uuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  archivedAt DateTime? // arquivada: some da lista principal, continua consultável
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages ConversationMessage[]
}

model ConversationMessage {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  status         MessageStatus @default(PRONTA)
  kind           String? // resposta | plano | erro
  plan           Json? // rascunho de job proposto pela IA (só vira job com aprovação)
  /// Diário interno de revisão independente; nunca é um plano aprovável.
  goldfishState  Json?
  /// Perguntas da IA com opções de clicar: [{ pergunta, opcoes: [{ rotulo, descricao }], multipla }]
  perguntas      Json?
  jobId          String? // job criado ao aprovar o plano
  approvedBy     String?
  approvedAt     DateTime?
  sessionId      String?
  costUsd        Decimal       @default(0) @db.Decimal(12, 4)
  /// Anexos da mensagem do usuário: [{ nome, tipo: imagem|texto, bytes, de? }] (arquivos em <projeto>/anexos/)
  attachments    Json?
  /// Enquanto a IA responde: a última atividade dela (ex.: "[ferramenta] Read src/app.ts"), para a tela.
  andamento      String?
  createdAt      DateTime      @default(now())
  /// Primeiro momento em que o worker invocou o provedor; null = resposta barrada antes da IA.
  startedAt      DateTime?
  /// Hora em que a resposta efetivamente ficou pronta/erro/cancelada (não confundir com createdAt).
  completedAt    DateTime?

  tasks QueueTask[]
}

model Project {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  description   String    @default("")
  areaId        String
  area          Area      @relation(fields: [areaId], references: [id])
  dirKey        String // pasta do projeto, relativa a NIVOO_WORKSPACES_ROOT
  workspacePath String
  provider      String    @default("claude-code-cli") // IA escolhida para este projeto (conversa e trabalhos)
  aiModels      Json      @default("{}") // modelo escolhido por IA neste projeto: { "<ia>": "<modelo>" }; ausente = padrão da IA
  /// IAs reserva, em ordem: se a IA do projeto ficar sem crédito/limite/login, o trabalho continua na próxima disponível
  aiReserva     Json?
  gitUrl        String? // repositório remoto (GitHub/GitLab) ligado ao projeto; null = projeto só local
  gitBranch     String? // branch remota que a pasta principal acompanha
  gitAccountId  String? // conta Git (credencial guardada fora do banco) usada para pull/push
  gitAutoPush   Boolean   @default(true) // versionar sozinho (commit + tag + push) a cada trabalho concluído — padrão
  gitLastSyncAt DateTime? // último envio/atualização bem-sucedido
  rulesVersion  Int       @default(0)
  /// Preferências visuais estruturadas; null = sem definição explícita.
  visualProfile Json?
  /// Controle de concorrência da edição visual (não é versão do schema JSON).
  visualProfileRevision Int @default(0)
  maxCostUsd    Decimal?  @db.Decimal(12, 4) // orçamento total do projeto (soma dos jobs); null = sem limite
  archivedAt    DateTime? // arquivado: some da lista principal de projetos
  /// Projeto de ORIGEM: quando este projeto é de vídeo/design feito a partir de outro (o agente Design de Vídeo cria um
  /// projeto separado para produzir o vídeo de um projeto de software, sem embolar os dois).
  projetoOrigemId String?
  projetoOrigem   Project?  @relation("origem", fields: [projetoOrigemId], references: [id], onDelete: SetNull)
  derivados       Project[] @relation("origem")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  conversations Conversation[]
  rules         ProjectRule[]
  jobs          Job[]
  memory        MemoryEntry[]
  artifacts     Artifact[]
  sshPedidos    SshPedido[]
  /// Plano que continua um pedido já aprovado começa sozinho (sem esperar o "Fazer")
  seguirSozinho  Boolean   @default(true)
  /// Motor da locução: Kokoro local (sem token) ou Gemini TTS (paga).
  motorNarracao       String @default("kokoro")
  /// Voz padrão do motor selecionado; ver providers/vozes.ts.
  vozNarracao         String @default("pf_dora")
  /// Velocidade natural do Kokoro (0,75–1,25).
  velocidadeNarracao  Float  @default(1)
  /// Substituições aplicadas só ao sintetizador, sem alterar o texto original: {"Nivoo Dev":"Nívoo Dév"}.
  pronunciasNarracao  Json   @default("{}")
  /// sem-trilha (Instagram depois), arquivo (enviado) ou ia (Lyria paga).
  modoTrilha          String @default("sem-trilha")
}

model Job {
  id                 String     @id @default(uuid())
  projectId          String
  project            Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  status             ExecStatus @default(PENDENTE)
  blockedReason      String?
  statusDetail       String?
  defaultProvider    String     @default("local-shell")
  objectiveVersion   Int        @default(1)
  approvedScope      Json?      // origem e alinhamento aprovado no chat; não é memória nem novo estado de Capability
  maxAttemptsPerStep Int        @default(3)
  maxDurationSec     Int        @default(3600)
  maxCostUsd         Decimal    @default(0) @db.Decimal(12, 4) // 0 = sem trava neste trabalho (o limite do projeto, se houver, vale)
  costSpentUsd       Decimal    @default(0) @db.Decimal(12, 4)
  stepTimeoutSec     Int        @default(900)
  repetitionWindow   Int        @default(2)
  maxSessionsPerStep Int        @default(8)
  gitBranch          String?
  mergeStatus        String? // INCORPORADO | CONFLITO: resultado do job na pasta principal do projeto
  mergedCommit       String?
  completionState    Json? // durable verified integration and publication receipt
  startedAt          DateTime?
  finishedAt         DateTime?
  activeSeconds      Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  objectives  JobObjectiveVersion[]
  criteria    AcceptanceCriterion[]
  steps       Step[]
  attempts    Attempt[]
  checkpoints Checkpoint[]
  artifacts   Artifact[]
  logs        LogEntry[]
  approvals   Approval[]
  tasks       QueueTask[]
  checks      CriterionCheck[]
}

// Objetivo imutável: append-only. Alterar o objetivo = criar nova versão.
model JobObjectiveVersion {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  version   Int
  text      String
  sha256    String
  author    String
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@unique([jobId, version])
}

model AcceptanceCriterion {
  id            String          @id @default(uuid())
  jobId         String
  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  key           String
  description   String
  kind          CriterionKind
  config        Json            @default("{}")
  status        CriterionStatus @default(PENDENTE)
  lastCheckedAt DateTime?
  createdAt     DateTime        @default(now())

  checks CriterionCheck[]

  @@unique([jobId, key])
}

// Evidência de cada verificação de critério feita pelo backend.
model CriterionCheck {
  id          String              @id @default(uuid())
  jobId       String
  job         Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   AcceptanceCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  passed      Boolean
  evidence    Json
  artifactId  String?
  createdAt   DateTime            @default(now())
}

model Step {
  id                String     @id @default(uuid())
  jobId             String
  job               Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  key               String
  order             Int
  title             String
  instructions      String // prompt (IA) ou comando (local-shell)
  provider          String? // null = job.defaultProvider
  dependsOn         String[]
  verifyCommand     String? // verificação determinística da etapa (obrigatória para conectores de IA)
  providerOptions   Json       @default("{}") // { model, maxTurns }
  requiresApproval  Boolean    @default(false)
  status            ExecStatus @default(PENDENTE)
  statusDetail      String?
  attemptCount      Int        @default(0)
  resumeFromAttempt Int        @default(0) // limites e repetição contam só tentativas com número maior (zerado a cada retomada)
  lastOutput        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  attempts    Attempt[]
  checkpoints Checkpoint[]

  @@unique([jobId, key])
}

model Attempt {
  id               String        @id @default(uuid())
  jobId            String
  job              Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stepId           String
  step             Step          @relation(fields: [stepId], references: [id], onDelete: Cascade)
  number           Int
  provider         String
  workerId         String
  hostname         String?
  pid              Int? // grupo de processos do agente (para encerrar órfãos após queda do worker)
  processIdentity  Json? // boot_id e starttime do líder observado pelo worker
  executionState   Json? // durable attempt phase and bounded continuation receipt
  sessionId        String? // id da sessão no provedor (ex.: session_id do Claude Code)
  stopReason       String? // motivo de término informado pelo provedor (completed, max_turns, api_error...)
  numTurns         Int?
  promptArtifactId String? // prompt exato recebido pela sessão (auditoria de continuidade)
  treeBefore       String? // hash da árvore do workspace antes/depois (detecção de progresso)
  treeAfter        String?
  notesIngested    Int           @default(0)
  contextStats     Json? // orçamento de contexto: tamanho, seções incluídas e itens omitidos
  status           AttemptStatus @default(EXECUTANDO)
  exitCode         Int?
  output           String?
  outputHash       String?
  error            String?
  costUsd          Decimal       @default(0) @db.Decimal(12, 4)
  costEstimated    Boolean       @default(false) // custo estimado por tokens (o provedor não informou: timeout/interrupção)
  inputTokens      Int?
  outputTokens     Int?
  startedAt        DateTime      @default(now())
  endedAt          DateTime?

  @@unique([stepId, number])
}

model Checkpoint {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stepId    String?
  step      Step?    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  seq       Int
  label     String
  state     Json
  gitCommit String?
  createdAt DateTime @default(now())

  @@unique([jobId, seq])
}

model Artifact {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stepId      String?
  attemptId   String?
  name        String
  kind        String // LOG, FILE, METRICS, REPORT, CRITERION_EVIDENCE
  storagePath String // relativo a NIVOO_ARTIFACTS_ROOT
  sha256      String
  sizeBytes   Int
  mimeType    String
  createdAt   DateTime @default(now())
}

model LogEntry {
  id        BigInt   @id @default(autoincrement())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stepId    String?
  attemptId String?
  level     LogLevel @default(INFO)
  source    String // system, worker, provider:<id>, evaluator
  message   String
  createdAt DateTime @default(now())

  @@index([jobId, id])
}

model Approval {
  id          String         @id @default(uuid())
  jobId       String?
  job         Job?           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  projectId   String
  kind        ApprovalKind
  subjectId   String // criterionId / stepId
  subjectHash String? // sha256 do conteúdo aprovado; a aprovação só vale para esse conteúdo
  description String
  status      ApprovalStatus @default(PENDENTE)
  decidedBy   String?
  reason      String?
  requestedAt DateTime       @default(now())
  decidedAt   DateTime?
}

model MemoryEntry {
  id             String         @id @default(uuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category       MemoryCategory
  title          String
  content        String
  references     Json           @default("{}") // { artifactIds, gitCommit, jobId, origem, ... }
  version        Int            @default(1)
  supersededById String?
  author         String
  createdAt      DateTime       @default(now())
  /// PROJETO: memória que o usuário vê (decisões, preferências, fatos, pendências), uma por assunto.
  /// INTERNA: memória do processo (notas das sessões, lições de falhas, registro de trabalhos), usada pela IA.
  camada         String         @default("PROJETO")
  /// Assunto (título normalizado): o mesmo assunto ATUALIZA o item (a versão anterior vai para o histórico).
  chave          String?

  @@index([projectId, camada, supersededById])
}

model QueueTask {
  id            String               @id @default(uuid())
  type          QueueTaskType
  jobId         String?
  job           Job?                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messageId     String?
  message       ConversationMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  stepId        String?
  status        QueueTaskStatus      @default(QUEUED)
  runAt         DateTime             @default(now())
  lockedBy      String?
  lockedUntil   DateTime?
  claims        Int                  @default(0)
  recoveries    Int                  @default(0) // reivindicações de lease EXPIRADO (worker caiu); só isso conta como "loop de quedas"
  internalErrorSignature String?
  internalErrorCount Int @default(0)
  resourceWaits Int                  @default(0) // esperas por recurso indisponível (define a espera crescente)
  lastError     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, runAt])
}

model ProviderConfig {
  id        String   @id // claude-code-cli, codex-cli, anthropic-api, openai-api, local-shell
  enabled   Boolean  @default(true)
  settings  Json     @default("{}") // NUNCA segredos
  updatedAt DateTime @updatedAt
}

model WorkerHeartbeat {
  id         String   @id
  hostname   String
  pid        Int
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  providers  Json     @default("{}") // status de cada conector visto por este worker
}

/// Comando que a IA pediu para rodar num servidor SSH: só roda depois que o usuário permite (cada comando).
model SshPedido {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  servidorId   String
  servidorNome String
  comando      String
  motivo       String    @default("")
  /// PENDENTE → APROVADO → EXECUTADO | FALHOU; ou RECUSADO; ou EXPIRADO (ninguém respondeu a tempo).
  status       String    @default("PENDENTE")
  jobId        String?
  mensagemId   String?
  decididoPor  String?
  decididoEm   DateTime?
  saida        String?
  exitCode     Int?
  createdAt    DateTime  @default(now())
  terminadoEm  DateTime?

  @@index([projectId, status])
}

// Shared transient provider quota state; no credentials or prompt content.
model ProviderCooldown {
  providerId String @id
  until DateTime
  failures Int @default(0)
  updatedAt DateTime @updatedAt
}
