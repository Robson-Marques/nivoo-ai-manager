#!/usr/bin/env node
'use strict';
// Verificador local de contrato da composição. Não rende MP4 nem usa IA.
const fs = require('node:fs');
const path = require('node:path');

function motionCore() {
  const dirs = [
    path.join(__dirname, 'motion-scene-core.js'),
    path.join(process.env.NIVOO_APP_DIR || '/opt/nivoo/app', 'apps/backend/bin/motion-scene-core.js'),
  ];
  const file=dirs.find(f=>fs.existsSync(f));
  if(!file) throw new Error('MOTION_CONTRATO: módulo motion-scene-core.js não instalado');
  return require(file);
}
function main(args=process.argv.slice(2)) {
  const pos=args.indexOf('--modo');
  const mode=pos>=0?args[pos+1]:'auto';
  const source=args[0];
  if(!source || !/^motion\/[A-Za-z0-9._/-]+$/.test(source) || source.split('/').includes('..'))
    throw new Error('MOTION_CONTRATO: origem inválida, use motion/<pasta>');
  // Compatibilidade com jobs antigos que já tinham esta ferramenta no
  // verifyCommand. Não reprovar uma composição pronta por características
  // de arte/asset. O render real decidirá se consegue produzir MP4.
  try {
    const result=motionCore().checkMotionSource(source,mode);
    (result.warnings??[]).forEach(w=>console.warn('NIVO_MOTION aviso: '+w));
    console.log('NIVO_MOTION: composição disponível; renderizador fará o trabalho, sem segunda aprovação');
    return result;
  } catch (e) {
    console.warn('NIVO_MOTION aviso (não bloqueante): '+String(e?.message??e));
    return {mode,warnings:[String(e?.message??e)]};
  }
}
if(require.main===module){
  try{main();}catch(e){console.warn('NIVO_MOTION aviso (não bloqueante): '+String(e?.message??e));}
}
module.exports={main};
