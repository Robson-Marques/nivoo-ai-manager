#!/usr/bin/env node
/**
 * nivoo-fotos — fotos das telas de um sistema rodando, para a conferência (sem a IA navegar).
 *
 * uso: nivoo-fotos <endereço-base> [caminho ...] [--pasta out/telas] [--exigir-sem-erros] [--sem-emoji-em-controles] [--esperar <ms>]
 *   ex.: nivoo-fotos http://127.0.0.1:$NIVOO_PORTA_TESTE / /pedidos /contato --exigir-sem-erros
 *
 * Para cada caminho, tira foto no tamanho de computador (1366×900) e de celular (390×844), e registra: erros do
 * console, erros de script, arquivos que não carregaram (4xx/5xx), tela em branco, rolagem para o lado no celular e
 * acentos quebrados (codificação); com --sem-emoji-em-controles, emoji usado como botão/ícone.
 * Grava as fotos e o relatório (relatorio.md e relatorio.json) na pasta (padrão out/telas — vira resultado do
 * trabalho; a IA abre as fotos na sessão seguinte). Com --exigir-sem-erros, sai com erro se achar algum problema.
 */
'use strict';
const fs = require('node:fs');
const path = require('node:path');

const args = process.argv.slice(2);
const opcao = (nome, padrao) => {
  const i = args.indexOf(nome);
  if (i < 0) return padrao;
  const v = args[i + 1];
  args.splice(i, 2);
  return v;
};
const exigir = args.includes('--exigir-sem-erros');
if (exigir) args.splice(args.indexOf('--exigir-sem-erros'), 1);
const semEmoji = args.includes('--sem-emoji-em-controles');
if (semEmoji) args.splice(args.indexOf('--sem-emoji-em-controles'), 1);
const pasta = opcao('--pasta', 'out/telas');
const esperar = Number(opcao('--esperar', '600'));
const [base, ...caminhosBrutos] = args;
if (!base || !/^https?:\/\//.test(base)) {
  console.error('uso: nivoo-fotos <endereço-base http://…> [caminho ...] [--pasta out/telas] [--exigir-sem-erros] [--esperar <ms>]');
  process.exit(2);
}
const caminhos = caminhosBrutos.length ? caminhosBrutos : ['/'];
const TAMANHOS = [
  { nome: 'computador', viewport: { width: 1366, height: 900 }, isMobile: false },
  { nome: 'celular', viewport: { width: 390, height: 844 }, isMobile: true },
];
const nomeDe = (c) => (c.replace(/^\/+|\/+$/g, '').replace(/[^a-zA-Z0-9]+/g, '-').slice(0, 60) || 'inicio');

(async () => {
  let chromium;
  try {
    ({ chromium } = require('playwright-core'));
  } catch {
    console.error('nivoo-fotos: navegador sem tela não instalado neste servidor (playwright-core ausente). Rode "nivoo update".');
    process.exit(3);
  }
  let navegador;
  try {
    navegador = await chromium.launch({ args: ['--no-sandbox'] });
  } catch (e) {
    console.error(`nivoo-fotos: navegador sem tela não abriu neste servidor (${String(e.message).split('\n')[0]}). Rode "nivoo update".`);
    process.exit(3);
  }
  fs.mkdirSync(pasta, { recursive: true });
  const origem = new URL(base).origin;
  const resultados = [];
  for (const caminho of caminhos) {
    for (const t of TAMANHOS) {
      const ctx = await navegador.newContext({ viewport: t.viewport, isMobile: t.isMobile, hasTouch: t.isMobile, deviceScaleFactor: 1 });
      const pagina = await ctx.newPage();
      const r = { caminho, tamanho: t.nome, foto: '', status: null, errosDoConsole: [], errosDeScript: [], naoCarregou: [], emBranco: false, rolagemParaOLado: false, emojiEmControles: [], acentosQuebrados: '', designObservado: null };
      pagina.on('console', (m) => m.type() === 'error' && r.errosDoConsole.push(m.text().slice(0, 300)));
      pagina.on('pageerror', (e) => r.errosDeScript.push(String(e.message).slice(0, 300)));
      pagina.on('response', (resp) => {
        if (resp.status() >= 400 && resp.url().startsWith(origem)) r.naoCarregou.push(`${resp.status()} ${resp.url().slice(origem.length) || '/'}`);
      });
      pagina.on('requestfailed', (req) => req.url().startsWith(origem) && r.naoCarregou.push(`falhou ${req.url().slice(origem.length) || '/'}`));
      try {
        const resp = await pagina.goto(new URL(caminho, base).toString(), { waitUntil: 'networkidle', timeout: 30_000 });
        r.status = resp ? resp.status() : null;
        await pagina.waitForTimeout(esperar);
        const medidas = await pagina.evaluate(() => ({
          largura: document.documentElement.scrollWidth,
          janela: document.documentElement.clientWidth || window.innerWidth,
          texto: (document.body?.innerText ?? '').trim().length,
          imagens: document.images.length + document.querySelectorAll('canvas,svg,video').length,
        }));
        r.rolagemParaOLado = t.isMobile && medidas.largura > medidas.janela + 1;
        // Acentos quebrados ("Ã§", "Ã£"…): texto em UTF-8 lido como outra codificação (falta <meta charset="utf-8">).
        r.acentosQuebrados = await pagina.evaluate(() => {
          const m = /\S*Ã[\u0080-\u00BF§£©¡³ªº\u00A0-\u00BF]\S*/.exec(document.body?.innerText ?? '');
          return m ? m[0].slice(0, 40) : '';
        });
        // Emoji em botão, link, menu ou navegação (no Studio Workflow, emoji não é ícone de UI).
        r.emojiEmControles = await pagina.evaluate(() => {
          const emoji = /\p{Extended_Pictographic}/u;
          return [...document.querySelectorAll('button, a, [role=button], [role=menuitem], [role=tab], nav *, label, summary')]
            .filter((el) => emoji.test(el.textContent || '') && el.children.length === 0)
            .slice(0, 10)
            .map((el) => `${el.tagName.toLowerCase()}: "${(el.textContent || '').trim().slice(0, 40)}"`);
        });
        r.emBranco = medidas.texto === 0 && medidas.imagens === 0;
        r.designObservado = await pagina.evaluate(async () => {
          const root = document.querySelector('[data-nivoo-profile-revision][data-nivoo-design-engine]');
          if (!root) return null;
          await document.fonts.ready;
          const css = getComputedStyle(root);
          const heading = root.querySelector('h1,h2,h3');
          return {
            revision: root.getAttribute('data-nivoo-profile-revision'),
            engine: root.getAttribute('data-nivoo-design-engine'),
            variant: root.getAttribute('data-glass-variant'),
            theme: root.getAttribute('data-theme'),
            palette: root.getAttribute('data-nivoo-palette'),
            density: root.getAttribute('data-nivoo-density'),
            accent: css.getPropertyValue('--nv-color-accent').trim(),
            body: css.fontFamily,
            heading: heading ? getComputedStyle(heading).fontFamily : null,
            surfaces: root.querySelectorAll('.liqui-glass').length,
            localFonts: [...document.fonts].map(f=>({family:f.family,status:f.status})),
          };
        });
        const altura = await pagina.evaluate(() => Math.min(document.documentElement.scrollHeight, 4000));
        r.foto = path.join(pasta, `${nomeDe(caminho)}-${t.nome}.png`);
        await pagina.screenshot({ path: r.foto, clip: { x: 0, y: 0, width: t.viewport.width, height: Math.max(altura, t.viewport.height) }, fullPage: true });
      } catch (e) {
        r.errosDeScript.push(`não abriu: ${String(e.message).split('\n')[0]}`);
      }
      resultados.push(r);
      await ctx.close();
    }
  }
  await navegador.close();

  const problemas = [];
  for (const r of resultados) {
    const onde = `${r.caminho} (${r.tamanho})`;
    if (r.status && r.status >= 400) problemas.push(`${onde}: a página respondeu ${r.status}`);
    for (const e of r.errosDeScript) problemas.push(`${onde}: erro de script: ${e}`);
    for (const e of r.errosDoConsole) problemas.push(`${onde}: erro no console: ${e}`);
    for (const e of [...new Set(r.naoCarregou)]) problemas.push(`${onde}: não carregou: ${e}`);
    if (r.emBranco) problemas.push(`${onde}: tela em branco (sem texto nem imagem)`);
    if (r.rolagemParaOLado) problemas.push(`${onde}: a página é mais larga que o celular (rolagem para o lado)`);
    if (r.acentosQuebrados) problemas.push(`${onde}: acentos aparecem quebrados ("${r.acentosQuebrados}") — falta <meta charset="utf-8"> ou o servidor manda outra codificação`);
    if (semEmoji) for (const e of r.emojiEmControles) problemas.push(`${onde}: emoji usado como ícone/controle (${e}) — use ícone semântico ou texto`);
  }
  fs.writeFileSync(path.join(pasta, 'relatorio.json'), JSON.stringify({ base, resultados, problemas }, null, 2));
  fs.writeFileSync(
    path.join(pasta, 'relatorio.md'),
    [
      `# Fotos das telas — ${base}`,
      '',
      ...resultados.map((r) => `- ${r.caminho} (${r.tamanho}): ${r.foto || 'sem foto'}`),
      '',
      '## Perfil visual observado (não substitui avaliação visual ou funcional)',
      ...resultados.map(r => r.designObservado
        ? `- ${r.caminho} (${r.tamanho}): ${JSON.stringify(r.designObservado)}`
        : `- ${r.caminho} (${r.tamanho}): módulo de perfil aprovado não identificado no DOM`),
      '',
      problemas.length ? '## Problemas encontrados' : '## Nenhum problema automático encontrado (confira as fotos)',
      ...problemas.map((p) => `- ${p}`),
      '',
    ].join('\n'),
  );
  console.log(`nivoo-fotos: ${resultados.filter((r) => r.foto).length} foto(s) em ${pasta}/ (relatorio.md)`);
  for (const p of problemas) console.log(`  problema: ${p}`);
  if (exigir && problemas.length) {
    console.error(`nivoo-fotos: ${problemas.length} problema(s) nas telas — veja ${pasta}/relatorio.md e as fotos`);
    process.exit(1);
  }
})().catch((e) => {
  console.error(`nivoo-fotos: falhou: ${e?.message ?? e}`);
  process.exit(4);
});
