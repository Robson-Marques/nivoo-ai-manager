#!/usr/bin/env node
/**
 * nivoo-renderizar-motion — transforma uma ANIMAÇÃO DE CÓDIGO (motion design: HTML/CSS/JS que a IA escreve) em vídeo,
 * capturando cada quadro no Playwright com relógio controlado e codificando com FFmpeg. SEM Veo e SEM custo.
 *
 * uso: nivoo-renderizar-motion <pasta|index.html> --saida midia/saida/<nome>.mp4 [--segundos 15] [--tamanho 1920x1080] [--fps 25]
 *   A página pode definir window.__motionSegundos (duração) e setar window.__motionFim = true quando terminar.
 *   Caminhos midia/... em --saida resolvem na pasta de mídia do projeto ($NIVOO_MIDIA_DIR).
 */
'use strict';
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
// Os comandos são instalados em /usr/local/bin, enquanto o pacote
// playwright-core pertence ao app em /opt/nivoo/app/node_modules.
// Resolver pelo diretório do projeto, não pelo diretório do binário.
function playwrightCore() {
  const bases = [process.env.NIVOO_APP_DIR, '/opt/nivoo/app', process.cwd(), path.resolve(__dirname, '../../..')]
    .filter(Boolean);
  try {
    return require(require.resolve('playwright-core', { paths: bases }));
  } catch (e) {
    throw new Error('playwright-core não encontrado na instalação Nivoo (/opt/nivoo/app/node_modules). Confira a etapa 6 de nivoo update. ' + (e?.message ?? e));
  }
}

const args = process.argv.slice(2);
const opt = (nome, padrao) => {
  const i = args.indexOf(nome);
  return i >= 0 ? args[i + 1] : padrao;
};
const flagsWithValue = new Set(['--saida','--segundos','--tamanho','--duracao-origem','--abertura-origem','--abertura-final','--ritmo','--motor','--fps']);
const alvoBruto = args.find((a, i) => !a.startsWith('--') && !flagsWithValue.has(args[i - 1]));
if (!alvoBruto) {
  console.error('uso: nivoo-renderizar-motion <pasta|index.html> --saida midia/saida/<nome>.mp4 [--segundos 15] [--tamanho 1920x1080] [--fps 25]');
  process.exit(2);
}
const motorExigido = opt('--motor', 'auto');
if (!['auto','scene','hybrid','html'].includes(motorExigido)) {
  console.error('MOTION_CONTRATO: --motor precisa ser auto, scene, hybrid ou html');
  process.exit(2);
}
const midiaDir = process.env.NIVOO_MIDIA_DIR || '';
const resolver = (rel) => (/^midia\//.test(rel) && midiaDir ? path.join(midiaDir, rel.replace(/^midia\//, '')) : path.resolve(rel));
let selected;
try { selected=motionSceneCore().resolveMotionSource(alvoBruto,motorExigido); }
catch(e){ console.error(String(e?.message??e)); process.exit(2); }
const entrada=selected.entry;
const saidaRel = opt('--saida', 'midia/saida/motion.mp4');
if (!/^midia\/saida\/[A-Za-z0-9._-]+\.mp4$/i.test(saidaRel)) {
  console.error('nivoo-renderizar-motion: --saida deve ser midia/saida/<nome>.mp4');
  process.exit(2);
}
const saida = resolver(saidaRel);
const fps = Number(opt('--fps', '25'));
if (!Number.isInteger(fps) || fps < 1 || fps > 60) {
  console.error('nivoo-renderizar-motion: --fps deve ser inteiro de 1 a 60');
  process.exit(2);
}
const segundosArg = Math.min(300, Math.max(1, Number(opt('--segundos', '15')) || 15));
const [W, H] = String(opt('--tamanho', '1920x1080')).split('x').map((n) => Number(n) || 0);
if (!Number.isInteger(W)||!Number.isInteger(H)||W<2||H<2||W%2||H%2) {
  console.error('nivoo-renderizar-motion: --tamanho deve ser como 1920x1080');
  process.exit(2);
}

function offlineRenderer() {
  // O comando pode ser chamado pelo checkout ou por /usr/local/bin.
  // Em ambos os casos usa o módulo versionado em /opt/nivoo/app.
  const locais = [
    path.join(__dirname, 'motion-offline-render.js'),
    path.join(process.env.NIVOO_APP_DIR || '/opt/nivoo/app', 'apps/backend/bin/motion-offline-render.js'),
  ];
  const encontrado = locais.find((p) => fs.existsSync(p));
  if (!encontrado) throw new Error('captura offline não instalada; execute nivoo update');
  return require(encontrado);
}

function motionSceneCore() {
  // /usr/local/bin recebe uma cópia do comando, mas não dos helpers.
  // Procurar primeiro a pasta atual do projeto e depois o checkout instalado.
  const candidates = [
    path.join(__dirname, 'motion-scene-core.js'),
    path.join(process.env.NIVOO_APP_DIR || '/opt/nivoo/app', 'apps/backend/bin/motion-scene-core.js'),
  ];
  const found = candidates.find(p => fs.existsSync(p));
  if (!found) throw new Error('motor declarativo não encontrado; confira /opt/nivoo/app/apps/backend/bin/motion-scene-core.js');
  return require(found);
}

(async () => {
  // Não executar uma segunda avaliação da composição pronta. O próprio
  // renderizador carrega as imagens e entrega o que conseguir produzir.
  // Erros técnicos reais (Chromium/FFmpeg/arquivo inexistente) são reportados
  // pela ferramenta que falhou, não por um aprovador anterior ao trabalho.
  const { chromium } = playwrightCore();
  const { renderMotionOffline: renderOffline, prepareMotionClock } = offlineRenderer();
  let navegador;
  let ctx;
  try {
    navegador = await chromium.launch({ args: ['--no-sandbox', '--disable-gpu', '--force-color-profile=srgb'] });
    // Não gravar WebM em tempo real; gravar JPEGs com checkpoint durável.
    // Se o worker cair, uma nova tentativa recupera os quadros já prontos.
    ctx = await navegador.newContext({ viewport: { width: W, height: H }, deviceScaleFactor: 1 });
    const pagina = await ctx.newPage();
    const erros = [];
    pagina.on('pageerror', (e) => erros.push(String(e.message).slice(0, 200)));
    // Controla Date, performance.now, setTimeout e requestAnimationFrame antes
    // de carregar o HTML. A captura de cada quadro não consome tempo da animação.
    // Pausar o relógio ANTES de carregar HTML/JS: os timers, CSS e rAF
    // começam já congelados. Nunca chamar pauseAt(Date.now()) depois de
    // carregar a página: entre avaliar e aplicar, o tempo pode avançar e
    // Playwright recusa a tentativa de voltar ao passado.
    const inicioVirtual = fs.statSync(entrada).mtimeMs;
    await prepareMotionClock(pagina, inicioVirtual);
    const declarativa = selected.mode === 'scene';
    if (declarativa) {
      // A IA cria dados, não shaders arbitrários. O motor oficial compõe as
      // imagens RGBA, sombras, z-index e velocidade dos elementos.
      const { loadScene, sceneDocument, productPhotoLayers } = motionSceneCore();
      const { scene, binaries, warnings } = loadScene(entrada);
      warnings.forEach(w => console.warn('nivoo-renderizar-motion: aviso de mídia: ' + w));
      const essenciais=productPhotoLayers(scene);
      const ausentes=essenciais.filter(l=>!binaries[l.asset]);
      if(ausentes.length) throw new Error('MOTION_MIDIA_AUSENTE: fotografias essenciais sem arquivo: '+
        ausentes.map(l=>l.id+' ('+String(l.asset??'sem referência').slice(0,90)+')').join(', ')+
        '. Sem chamar IA nem exportar um MP4 com produto invisível.');
      if (scene.width !== W || scene.height !== H)
        console.warn(`nivoo-renderizar-motion: tamanho de cena ${scene.width}x${scene.height} diferente da saída ${W}x${H}; renderizando e deixando avaliação visual ao usuário`);
      await pagina.setContent(sceneDocument(scene, binaries), { waitUntil: 'load', timeout: 30_000 });
      let deadline;
      try {
        await Promise.race([
          pagina.evaluate(() => window.__nivooSceneLoadPromise),
          new Promise((_, reject) => { deadline = setTimeout(
            () => reject(new Error('Tempo limite de 30s para carregar imagens da cena')), 30_000); }),
        ]);
      } finally { clearTimeout(deadline); }
      const error = await pagina.evaluate(() => window.__nivooSceneError);
      if (error) throw new Error('Falha ao preparar camadas da cena: ' + error);
      const loadedKeys=await pagina.evaluate(()=>window.__nivooSceneLoadedKeys??[]);
      const falhas=essenciais.filter(l=>!loadedKeys.includes(l.asset));
      if(falhas.length) throw new Error('MOTION_MIDIA_AUSENTE: imagem não decodificou no Chromium: '+
        falhas.map(l=>l.id).join(', '));
      console.log('nivoo-renderizar-motion: motor declarativo, fotos RGBA em camada única, ritmo de cena controlado pelo Nivo');
    } else {
      const runtime = [path.join(__dirname,'motion-graphics.js'),
        path.join(process.env.NIVOO_APP_DIR || '/opt/nivoo/app','apps/backend/bin/motion-graphics.js')].find(p=>fs.existsSync(p));
      if(!runtime) throw new Error('biblioteca gráfica Motion não instalada');
      await pagina.addInitScript(require(runtime).installMotionGraphics);
      await pagina.goto(`file://${entrada}`, { waitUntil: 'load', timeout: 30_000 });
      const overlayPath = selected.overlayPath;
      if (overlayPath) {
        // WebGL customizado desenha malhas/objetos 3D; fotos e logomarcas
        // ficam numa camada RGBA independente ACIMA da geometria,
        // sem Z-fighting, oclusão nem fotos escuras duplicadas.
        const { loadScene, overlayScript, mountMediaOverlay, productPhotoLayers } = motionSceneCore();
        const { scene, binaries, warnings } = loadScene(overlayPath);
        warnings.forEach(w => console.warn('nivoo-renderizar-motion: aviso de mídia: ' + w));
        const essenciais=productPhotoLayers(scene);
        const ausentes=essenciais.filter(l=>!binaries[l.asset]);
        if(ausentes.length) throw new Error('MOTION_MIDIA_AUSENTE: fotos de produtos sem arquivo: '+
          ausentes.map(l=>l.id+' ('+String(l.asset??'sem referência').slice(0,90)+')').join(', ')+
          '. Não será gerado MP4 sem as fotografias.');
        if (scene.width !== W || scene.height !== H) console.warn(
          `nivoo-renderizar-motion: overlay ${scene.width}x${scene.height} e saída ${W}x${H}; mantendo render para avaliação`);
        // O relógio do overlay usa tempo de ORIGEM do WebGL; a duração
        // declarada deve ser a da composição antes de qualquer aceleração.
        const sourceDuration=Number(await pagina.evaluate(()=>window.__motionSegundos));
        if (Number.isFinite(sourceDuration) && sourceDuration>0 &&
            Math.abs(scene.duration-sourceDuration)>0.12) {
          console.warn('nivoo-renderizar-motion: duração do overlay ('+scene.duration+
            's) diferente da composição ('+sourceDuration+
            's); preservando saída e permitindo revisão visual');
        }
        await pagina.evaluate(mountMediaOverlay, { width: W, height: H });
        await pagina.addScriptTag({ content: overlayScript(scene, binaries) });
        let deadline;
        try {
          await Promise.race([
            pagina.evaluate(() => window.__nivooOverlayLoadPromise),
            new Promise((_, reject) => { deadline = setTimeout(
              () => reject(new Error('Tempo limite de 30s carregando fotos da camada WebGL')), 30_000); }),
          ]);
        } finally { clearTimeout(deadline); }
        const stats=await pagina.evaluate(()=>window.__nivooOverlayStats||{});
        const falhas=essenciais.filter(l=>!(stats.loadedAssetKeys??[]).includes(l.asset));
        if(falhas.length) throw new Error('MOTION_MIDIA_AUSENTE: foto não decodificou no Chromium: '+
          falhas.map(l=>l.id+' ('+String(l.asset).slice(0,90)+')').join(', '));
        await pagina.evaluate(ids=>{window.__nivooRequiredProductPhotoIds=ids;},
          essenciais.map(l=>l.id));
        console.log('nivoo-renderizar-motion: fotos/produtos carregados no WebGL; '+
          'arquivos='+String(stats.loaded??0)+'; fotos essenciais='+essenciais.map(l=>l.id).join(', '));
      }
    }
    const segundosFonte = Math.min(300, Math.max(1,
      Number(await pagina.evaluate(() => window.__motionSegundos).catch(() => 0)) || segundosArg));
    // Duração explícita pertence ao contrato de entrega, inclusive no motor declarativo.
    let segundos = args.includes('--segundos') ? segundosArg : segundosFonte;
    let pacing = Math.abs(segundos-segundosFonte)>0.001 ? {sourceDuration:segundosFonte} : null;
    const modoRitmo = opt('--ritmo','normal');
    if (!['normal','energetico'].includes(modoRitmo)) throw new Error('--ritmo deve ser normal ou energetico');
    const temRitmoExplicit = ['--duracao-origem','--abertura-origem','--abertura-final'].some(f=>args.includes(f));
    if (!declarativa && (temRitmoExplicit || modoRitmo === 'energetico')) {
      // A composição original NÃO é modificada. Apenas a captura virtual
      // percorre seu relógio mais rápido na abertura e no resto das cenas.
      segundos = args.includes('--segundos') ? segundosArg : Math.max(1,Math.round(segundosFonte*.8));
      // Se o autor já acelerou a abertura no HTML e não alterou a duração
      // total, aplicar um segundo timewarp faria a abertura de 3,5s virar
      // ~1,7s. Não remodelar uma composição pronta só por flag automática.
      if (!temRitmoExplicit && Math.abs(segundos-segundosFonte)<.1) {
        pacing=null;
        console.log('nivoo-renderizar-motion: mantendo ritmo da composição pronta; sem aceleração duplicada');
      } else {
        const sourceDuration = Number(opt('--duracao-origem', String(segundosFonte)));
        const openingEnd = Number(opt('--abertura-origem', String(sourceDuration*.29)));
        const openingSeconds = Number(opt('--abertura-final', String(Math.min(3.5,segundos*.25))));
        pacing = {sourceDuration,openingEnd,openingSeconds};
        if (!Number.isFinite(sourceDuration) || sourceDuration <= 0 ||
            !Number.isFinite(openingEnd) || openingEnd <= 0 || openingEnd >= sourceDuration ||
            !Number.isFinite(openingSeconds) || openingSeconds <= 0 || openingSeconds >= segundos)
          throw new Error('Parâmetros de ritmo inválidos: confira duração de origem, abertura e duração de saída');
        console.log(`nivoo-renderizar-motion: ritmo ${modoRitmo}, origem ${sourceDuration}s, saída ${segundos}s, abertura ${openingEnd}s→${openingSeconds}s`);
      }
    }
    const result = await renderOffline({
      page: pagina, outputPath: saida, sourcePath: entrada, seconds: segundos, width: W, height: H, fps, pacing, sourceMode:selected.mode,
      onProgress: ({ message }) => console.log(`nivoo-renderizar-motion: ${message}`),
    });
    // Relatar o que de fato foi DESENHADO durante os quadros. Isso não
    // cria aprovador nem tenta reescrever o trabalho; o MP4 é entregue.
    const photoResult=await pagina.evaluate(()=>window.__nivooOverlayStats??null).catch(()=>null);
    if(photoResult?.expected) {
      const drawn=photoResult.everDrawnIds??[];
      console.log('nivoo-renderizar-motion: imagens efetivamente desenhadas no vídeo: '+
        drawn.length+'/'+photoResult.expected+' ('+drawn.join(', ')+')');
      if(drawn.length<photoResult.expected)
        console.warn('nivoo-renderizar-motion: AVISO — algumas imagens de overlays.json não aparecem nos quadros; confira os caminhos das fotos e a animação das camadas');
    }
    if (erros.length) console.error(`nivoo-renderizar-motion: aviso — erro de script na animação: ${erros[0]}`);
    console.log(`nivoo-renderizar-motion: ${saidaRel} (${W}x${H}, ${segundos.toFixed(1)} s, ${(result.bytes / 1024 / 1024).toFixed(1)} MB, ${result.frames} quadros a ${result.fps} fps)`);
  } finally {
    if (ctx) await ctx.close().catch(() => {});
    if (navegador) await navegador.close().catch(() => {});
  }
})().catch((e) => {
  console.error(`nivoo-renderizar-motion: falhou: ${e?.message ?? e}`);
  process.exitCode = 4;
});
