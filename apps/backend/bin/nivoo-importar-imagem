#!/usr/bin/env node
/**
 * Importa uma imagem realmente anexada no chat, sem IA nem rede.
 * Uso: nivoo-importar-imagem contexto/anexos/<mensagem>/<foto.png> motion/foto.png
 * Um destino PNG de uma foto JPG é convertido com FFmpeg local.
 */
'use strict';
const fs=require('node:fs');
const path=require('node:path');
const cp=require('node:child_process');

function under(root, candidate) {return candidate.startsWith(root+path.sep);}
function run() {
  const [sourceRel,targetRel]=process.argv.slice(2);
  if(!sourceRel||!targetRel) throw Error('uso: nivoo-importar-imagem contexto/anexos/<id>/<imagem> <destino.png>');
  if(!/^contexto\/anexos\/[\w-]+\/[\w .()\-]+\.(?:png|jpe?g|webp)$/i.test(sourceRel)) {
    throw Error('origem deve ser uma imagem anexada em contexto/anexos/<mensagem>/<nome>');
  }
  if(path.isAbsolute(targetRel)||targetRel.split(/[\\/]/).includes('..')||
     !/\.(?:png|jpe?g|webp)$/i.test(targetRel)) {
    throw Error('destino inválido: use um caminho relativo de imagem, sem ..');
  }
  const root=fs.realpathSync(process.cwd());
  const source=fs.realpathSync(path.resolve(root,sourceRel));
  const attachmentsRoot=fs.realpathSync(path.join(root,'contexto','anexos'));
  if(!under(root,source)||!under(attachmentsRoot,source))throw Error('anexo fora da pasta autorizada');
  const dest=path.resolve(root,targetRel);
  if(!under(root,dest)||targetRel.startsWith('contexto/')||targetRel.startsWith('.git/')||
    targetRel.startsWith('.nivoo/'))throw Error('destino protegido ou fora do projeto');
  fs.mkdirSync(path.dirname(dest),{recursive:true});
  if(!under(root,fs.realpathSync(path.dirname(dest))))throw Error('destino resolve para fora do projeto');
  if(fs.existsSync(dest))throw Error('destino já existe; não sobrescrever sem revisão: '+targetRel);
  const buffer=fs.readFileSync(source);
  if(buffer.length<20)throw Error('imagem anexada vazia ou inválida');
  const png=buffer.subarray(0,8).equals(Buffer.from([137,80,78,71,13,10,26,10]));
  const jpg=buffer[0]===255&&buffer[1]===216&&buffer[2]===255;
  const webp=buffer.toString('ascii',0,4)==='RIFF'&&buffer.toString('ascii',8,12)==='WEBP';
  if(!png&&!jpg&&!webp)throw Error('anexo não é PNG/JPEG/WEBP válido');
  const ext=path.extname(dest).toLowerCase();
  const same=(png&&ext==='.png')||(jpg&&['.jpg','.jpeg'].includes(ext))||(webp&&ext==='.webp');
  const temp=dest+'.'+process.pid+'.partial'+ext;
  try{
    if(same) fs.copyFileSync(source,temp);
    else{
      const r=cp.spawnSync('ffmpeg',['-hide_banner','-loglevel','error','-nostdin','-y','-i',source,
        '-frames:v','1','-update','1',temp],{timeout:30000,encoding:'utf8',maxBuffer:512*1024});
      if(r.status!==0)throw Error('conversão FFmpeg falhou: '+(r.stderr||r.error?.message||'sem detalhes').slice(0,300));
    }
    if(fs.statSync(temp).size<20)throw Error('arquivo de saída vazio');
    if(ext==='.png'&&!fs.readFileSync(temp).subarray(0,8).equals(Buffer.from([137,80,78,71,13,10,26,10])))throw Error('destino não contém PNG real');
    fs.renameSync(temp,dest);
  }finally{if(fs.existsSync(temp))fs.rmSync(temp,{force:true})}
  console.log('Imagem importada: '+sourceRel+' => '+targetRel+' ('+fs.statSync(dest).size+' bytes)');
}
try{run()}catch(e){console.error('nivoo-importar-imagem: '+(e.message||e));process.exitCode=1}
