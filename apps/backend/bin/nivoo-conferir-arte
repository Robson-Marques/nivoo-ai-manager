#!/usr/bin/env node
'use strict';
/**
 * Prévia de direção de arte ANTES do MP4, sem chamar IA nem codificar vídeo.
 * Uso: nivoo-conferir-arte motion/<pasta> --saida out/qualidade/<nome> [--segundos 25] [--tamanho 1080x1920]
 * Gera quadro.png (final), quadros temporais e evidencias.json. A comparação
 * artística é feita pela revisão com referência, INCLUINDO movimento real.
 */
const fs = require('node:fs');
const path = require('node:path');
// Os comandos são instalados em /usr/local/bin, enquanto o pacote
// playwright-core pertence ao app em /opt/nivoo/app/node_modules.
// Resolver pelo diretório do projeto, não pelo diretório do binário.
function playwrightCore() {
  const bases = [process.env.NIVOO_APP_DIR, '/opt/nivoo/app', process.cwd(), path.resolve(__dirname, '../../..')]
    .filter(Boolean);
  try {
    return require(require.resolve('playwright-core', { paths: bases }));
  } catch (e) {
    throw new Error('playwright-core não encontrado na instalação Nivoo (/opt/nivoo/app/node_modules). Confira a etapa 6 de nivoo update. ' + (e?.message ?? e));
  }
}

const args = process.argv.slice(2);
const opt = (key, fallback) => { const i = args.indexOf(key); return i >= 0 ? args[i + 1] : fallback; };
const raw = args[0] || '';
const output = opt('--saida', '');
const seconds = Number(opt('--segundos', '15'));
const dimensions = String(opt('--tamanho', '1080x1920'));
const m = /^(\d{2,5})x(\d{2,5})$/.exec(dimensions);
if (!/^motion\/[a-zA-Z0-9._/-]+$/.test(raw) || raw.split('/').includes('..') ||
    !/^out\/qualidade\/[a-zA-Z0-9_-]+$/.test(output) ||
    !m || !Number.isFinite(seconds) || seconds < 1 || seconds > 120) {
  console.error('Uso: nivoo-conferir-arte motion/<pasta> --saida out/qualidade/<id> --segundos 25 --tamanho 1080x1920');
  process.exit(2);
}
let entry = path.resolve(raw);
if (fs.existsSync(entry) && fs.statSync(entry).isDirectory()) entry = path.join(entry, 'index.html');
if (!fs.existsSync(entry) || !fs.statSync(entry).isFile()) {
  console.error('Prévia visual: arquivo de composição ausente: ' + raw);
  process.exit(2);
}
const dir = path.resolve(output);
const refs = [];
const root = path.resolve('contexto', 'anexos');
const visit = (folder, depth) => {
  if (depth > 3 || refs.length >= 30 || !fs.existsSync(folder)) return;
  for (const item of fs.readdirSync(folder, { withFileTypes: true })) {
    if (refs.length >= 30) break;
    if (item.isSymbolicLink()) continue;
    const abs = path.join(folder, item.name);
    if (item.isDirectory()) visit(abs, depth + 1);
    else if (item.isFile() && /\.(png|jpe?g|webp)$/i.test(item.name))
      refs.push(path.relative(process.cwd(), abs).split(path.sep).join('/'));
  }
};
visit(root, 0);
(async () => {
  const { chromium } = playwrightCore();
  const browser = await chromium.launch({ args: ['--no-sandbox', '--disable-gpu', '--force-color-profile=srgb'] });
  try {
    const page = await browser.newPage({ viewport: { width: Number(m[1]), height: Number(m[2]) }, deviceScaleFactor: 1 });
    const errors = [];
    page.on('pageerror', e => { if (errors.length < 20) errors.push(String(e.message).slice(0, 220)); });
    page.on('console', msg => {
      // Erros de shader/WebGL podem ocorrer no console SEM pageerror.
      const line = String(msg.text()).slice(0, 320);
      if (msg.type() === 'error' && /WebGL|shader|uniform|link program/i.test(line) && errors.length < 20)
        errors.push(line);
    });
    const runtime = [path.join(__dirname,'motion-graphics.js'),
      path.join(process.env.NIVOO_APP_DIR || '/opt/nivoo/app','apps/backend/bin/motion-graphics.js')].find(p=>fs.existsSync(p));
    if(runtime) await page.addInitScript(require(runtime).installMotionGraphics);
    await page.goto('file://' + entry, { waitUntil: 'load', timeout: 30000 });
    // Capturar a LINHA DO TEMPO real. Quadro final sozinho não revela
    // megafone invertido, neon mal direcionado nem moldura quebrada.
    const declarado = Number(await page.evaluate(() => window.__motionSegundos).catch(() => 0));
    const duracao = Number.isFinite(declarado) && declarado >= 1 && declarado <= 120 ? declarado : seconds;
    fs.mkdirSync(dir, { recursive: true });
    const marcas = [0.08, 0.25, 0.45, 0.65, 0.78, 0.85, 0.94].map(p => duracao * p);
    const quadros = [];
    const inicio = Date.now();
    const deadline = inicio + duracao * 1000;
    let ponto = 0;
    while (Date.now() < deadline) {
      const decorrido = (Date.now() - inicio) / 1000;
      if (ponto < marcas.length && decorrido >= marcas[ponto]) {
        const nome = 'quadro-' + String(ponto + 1).padStart(2, '0') + '.png';
        const arquivo = path.join(dir, nome);
        await page.screenshot({ path: arquivo, fullPage: false, animations: 'allow' });
        quadros.push({ segundo: Number(((Date.now() - inicio) / 1000).toFixed(2)),
          arquivo: path.relative(process.cwd(), arquivo).split(path.sep).join('/') });
        ponto++;
      }
      if (await page.evaluate(() => window.__motionFim === true).catch(() => false)) break;
      await page.waitForTimeout(100);
    }
    const frame = path.join(dir, 'quadro.png');
    await page.screenshot({ path: frame, fullPage: false, animations: 'allow' });
    if (quadros.length < 4) errors.push('ANIMACAO_INCOMPLETA: não foi possível capturar quatro instantes distintos; conferir duração e sinal __motionFim.');
    const report = {
      tipo: 'preflight-visual', origem: raw, quadro: path.relative(process.cwd(), frame).split(path.sep).join('/'),
      largura: Number(m[1]), altura: Number(m[2]), segundosSolicitados: seconds, duracaoDeclarada: duracao,
      quadros,
      referenciasDisponiveis: refs, referenciaEscolhidaAutomaticamente: false,
      errosJavascript: errors,
      observacao: 'A prévia inclui quadros reais de vários instantes. A direção de arte deve verificar orientação e trajetória de efeitos, molduras fechadas e ritmo. Uma captura final isolada NÃO valida o movimento.',
    };
    fs.writeFileSync(path.join(dir, 'evidencias.json'), JSON.stringify(report, null, 2));
    console.log('Prévia temporal capturada: ' + quadros.length + ' quadros + final ' + report.quadro + ' | referências: ' + refs.length);
    if (errors.length) {
      console.error('Composição contém erro JS: ' + errors[0]);
      process.exitCode = 4;
    }
  } finally {
    await browser.close();
  }
})().catch(e => { console.error('Falha ao capturar composição: ' + (e?.message || e)); process.exitCode = 4; });
