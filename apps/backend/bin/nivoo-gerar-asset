#!/usr/bin/env node
/**
 * Gera um gráfico transparente original (PNG) com Playwright local.
 * Entrada: JSON {variant,title,subtitle,accent?}; saída: PNG.
 * Sem IA, sem rede, sem fontes remotas e sem assets de terceiros.
 */
'use strict';
const fs=require('node:fs');
const path=require('node:path');
const { chromium }=require('playwright-core');
function htmlEscape(s) {return String(s??'').replace(/[&<>"']/g,v=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[v]));}
const variants=new Set(['spreadsheet','clock','progress','warning','money','check','generic']);
const symbols={spreadsheet:'▦',clock:'◷',progress:'◉',warning:'!',money:'R$',check:'✓',generic:'✦'};
async function main(){
 const [configFile,output]=process.argv.slice(2);
 if(!configFile||!output)throw Error('uso: nivoo-gerar-asset <config.json> <saida.png>');
 const data=JSON.parse(fs.readFileSync(configFile,'utf8'));
 const variant=variants.has(data.variant)?data.variant:'generic';
 if(typeof data.title!=='string'||!data.title.trim()||data.title.length>55)throw Error('título inválido');
 if(data.subtitle!==undefined&&(typeof data.subtitle!=='string'||data.subtitle.length>100))throw Error('subtítulo inválido');
 const title=htmlEscape(data.title),subtitle=htmlEscape(data.subtitle||'');
 const accent=/^#[a-f0-9]{6}$/i.test(data.accent||'')?data.accent:'#65D6ED';
 // Vista independente da fonte do projeto: o usuário pode usar como overlay recortável.
 const pageHtml='<!doctype html><html><head><meta charset="UTF-8"><style>'+
 '*{box-sizing:border-box}body{margin:0;background:transparent;font-family:Arial,sans-serif}'+
 '.card{width:720px;height:400px;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden;border-radius:40px;'+
 'background:linear-gradient(135deg,#131c33ed,#111629f7);border:3px solid '+accent+'55;box-shadow:0 20px 70px #0008;color:#f7fbff;padding:50px 58px}'+
 '.card:before{content:"";position:absolute;right:-135px;top:-150px;width:420px;height:420px;border-radius:50%;background:'+accent+'1c}'+
 '.marker{width:max-content;display:flex;align-items:center;gap:13px;padding:8px 17px;background:'+accent+'22;border-radius:22px;color:'+accent+';font-weight:900;font-size:21px;letter-spacing:1px}'+
 '.icon{font-size:36px;font-weight:900;color:'+accent+';line-height:1}h1{font-size:53px;line-height:1.06;max-width:590px;margin:20px 0 12px;font-weight:900;letter-spacing:-1.8px;overflow-wrap:anywhere}'+
 'p{font-size:25px;line-height:1.35;margin:0;color:#bfcee3;max-width:580px;overflow-wrap:anywhere}'+
 '.line{position:absolute;bottom:32px;left:58px;width:148px;height:7px;border-radius:8px;background:'+accent+'}</style></head><body>'+
 '<article class="card"><div class="marker"><span class="icon">'+symbols[variant]+'</span><span>'+variant.toUpperCase()+'</span></div>'+
 '<h1>'+title+'</h1><p>'+subtitle+'</p><div class="line"></div></article></body></html>';
 const browser=await chromium.launch({args:['--no-sandbox','--disable-gpu']});
 try{
   const page=await browser.newPage({viewport:{width:720,height:400},deviceScaleFactor:1});
   await page.route('**/*',route=>route.abort());
   await page.setContent(pageHtml,{waitUntil:'load'});
   await page.screenshot({path:output,type:'png',omitBackground:true});
   if(fs.statSync(output).size<2000)throw Error('imagem gerada inválida');
   console.log('Asset local criado: '+output);
 }finally{await browser.close()}
}
main().catch(e=>{console.error('nivoo-gerar-asset: '+String(e.message||e));process.exitCode=1;});
