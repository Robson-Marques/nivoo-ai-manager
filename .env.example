# Copie para apps/backend/.env (nunca versione o .env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nivoo
PORT=3000
# Diretórios autorizados (workspaces isolados e armazenamento de artefatos)
NIVOO_WORKSPACES_ROOT=./data/workspaces
NIVOO_ARTIFACTS_ROOT=./data/artifacts
# Identificador do worker (opcional; padrão = hostname-pid)
# NIVOO_WORKER_ID=worker-1
# Conectores de API opcionais (segredos só aqui, nunca no banco/git)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
