// =====================================================================
// Dominio Comprador x Vendedor - WIN, grafico de 15 minutos
// APLICAR EM GRAFICO DE 15 MINUTOS (indicador de leitura, sem ordens).
//
// Pergunta que o indicador responde a cada atualizacao:
//   "Agora, nos 15 minutos, quem controla o movimento?"
//
// IDEIA CENTRAL
//   Agressao e ESFORCO; deslocamento do preco e RESULTADO. So existe
//   dominio quando o preco responde e sustenta o movimento. Por isso o
//   estado (comprador / vendedor / disputa) vem da resposta do preco, e
//   a agressao entra como confirmacao (ou como sinal de absorcao), nunca
//   sozinha.
//
// COMPONENTES (todos normalizados entre -1 e +1, + = comprador)
//   D - Eficiencia do deslocamento: (preco atual - preco N candles atras)
//       dividido pelo caminho total percorrido. +1 = subiu em linha reta,
//       0 = andou e voltou, -1 = caiu em linha reta. (Efficiency Ratio de
//       Kaufman, com sinal.)
//   P - Posicao no range: onde o preco esta entre a minima e a maxima dos
//       ultimos N candles. +1 = na maxima, -1 = na minima. Mede se o lado
//       que empurrou esta conseguindo SUSTENTAR o preco.
//   C - Estrutura dos candles: media de onde cada candle fechou dentro da
//       propria amplitude ((C-L)-(H-C))/(H-L). Fechamentos nas maximas =
//       compradores defendendo; pavios de rejeicao puxam para o outro lado.
//   F - Saldo de agressao: (agressao compra - agressao venda) / total.
//       Usado para confirmar ou para apontar absorcao, nao para decidir.
//
//   Placar (S) = (D + P + C) / 3. Pesos iguais porque nao ha evidencia
//   para privilegiar um componente; os tres medem o preco por angulos
//   diferentes (direcao, sustentacao, estrutura).
//
// DOIS HORIZONTES
//   Maior = PeriodoMaior candles (padrao 16 = 4 horas, cerca de metade do
//           pregao do WIN de 9h a 18h25). E o "movimento maior".
//   Atual = PeriodoAtual candles (padrao 4 = 1 hora). E o movimento de
//           agora, que pode ser so uma correcao do maior.
//
// CANDLE EM FORMACAO E OSCILACOES DE SEGUNDOS
//   O candle de 15m aberto entra com peso proporcional aos contratos ja
//   negociados nele, comparados com a media por candle (peso maximo 1).
//   Logo apos a abertura, quando o candle ainda nao diz nada, ele quase
//   nao pesa. Nao usa o relogio do computador: funciona igual no replay.
//   Alem disso o estado usa HISTERESE: para entrar em dominio o placar
//   precisa passar de LimiteEntrada; para sair, precisa cair abaixo de
//   LimiteSaida. A faixa entre os dois evita a troca de leitura quando o
//   placar fica oscilando em torno de um unico valor.
//
// CORRECAO x MUDANCA DE DOMINIO
//   Quando o movimento atual vai contra o maior:
//   - CORRECAO: o preco ainda esta na metade do range maior que pertence
//     ao lado dominante (P maior mantem o sinal). O movimento contrario
//     ainda nao tirou do lado dominante a metade do terreno conquistado.
//   - POSSIVEL VIRADA: o preco ja cruzou a metade do range maior (50% de
//     retracao) E a agressao do movimento atual confirma o lado contrario.
//
// SEM DADOS FUTUROS
//   So usa o candle atual e candles anteriores. Candles fechados nao
//   mudam depois. O candle aberto e provisorio por natureza e assume o
//   valor final quando fecha. O estado de cada candle depende so do
//   estado do candle anterior (histerese), nada a frente.
//
// LIMITACOES
//   - AgressionVolBuy/AgressionVolSell exigem Profit Ultra, Pro com
//     Plugin TR ou modulo Scalper (manual NTSL, secoes 20.8 e 20.9).
//   - Os limites (0,30 / 0,15) e periodos (4 / 16) sao pontos de partida
//     justificados nos comentarios dos inputs, nao regras comprovadas.
//     Valide no seu historico.
// =====================================================================

input
  PeriodoAtual(4);        // 4 x 15m = 1 hora: movimento de agora
  PeriodoMaior(16);       // 16 x 15m = 4 horas: ~metade do pregao do WIN
  LimiteEntrada(0.30);    // placar para ENTRAR em dominio (escala -1 a +1)
  LimiteSaida(0.15);      // placar para SAIR do dominio (metade da entrada)
  LimiteAgressao(0.10);   // saldo de agressao relevante (10% do total)
  PintarCandles(true);    // pinta os candles com o estado do movimento maior
  MostrarTexto(false);    // texto no ultimo candle (desligado: o PlotText
                          // na janela do indicador estragava a escala)

var
  // series por candle
  vBuy, vSell, vCLV, vMove : Float;
  // peso do candle em formacao
  vQtdMedia : Float;
  vPeso, vClose, vFechAnt, vRefM, vRefA : Float;
  // horizonte maior
  vSBM, vSSM, vFM, vDM, vPM, vCM, vSM, vPathM, vHHM, vLLM : Float;
  // horizonte atual
  vSBA, vSSA, vFA, vDA, vPA, vCA, vSA, vPathA, vHHA, vLLA : Float;
  // estados: 1 = comprador, -1 = vendedor, 0 = disputa
  vEstM, vEstA : Integer;
  vEstMAnt, vEstAAnt : Integer;   // estados do candle anterior
  vCompra, vVenda : Float;
  vLeitura, vAgr : Integer;

begin
  // ---------------- dados de cada candle ----------------
  // Abs: o "TR - Volume de Agressao - Venda" pode vir negativo (desenhado
  // para baixo). Sem o Abs, compra + venda fica perto de zero e o saldo
  // explode (foi o que esticou a escala da janela para 128 mil).
  vBuy  := Abs(AgressionVolBuy);
  vSell := Abs(AgressionVolSell);

  if High > Low then
    vCLV := ((Close - Low) - (High - Close)) / (High - Low)
  else
    vCLV := 0;

  vMove := Abs(Close - Close[1]);

  // ---------------- peso do candle em formacao ----------------
  // candles fechados: peso 1. Candle aberto: contratos ja negociados nele
  // / media de contratos por candle no horizonte maior (maximo 1).
  // Usa so dados do grafico (nao o relogio do computador), entao funciona
  // igual ao vivo e no replay. Um candle que ainda negociou pouco tem
  // pouca informacao e pesa pouco.
  vQtdMedia := (Summation(Quantity, PeriodoMaior + 1) - Quantity) / PeriodoMaior;
  vPeso := 1;
  if LastBarOnChart and (vQtdMedia > 0) then
    vPeso := Min(1, Quantity / vQtdMedia);

  // preco efetivo: no inicio do candle fica perto do fechamento anterior
  // e vai para o preco atual conforme o candle amadurece
  vFechAnt := Close[1];
  vClose := vFechAnt + vPeso * (Close - vFechAnt);
  vRefM  := Close[PeriodoMaior];
  vRefA  := Close[PeriodoAtual];

  // estados do candle anterior lidos fora de qualquer condicao
  // (o manual desaconselha acesso [n] dentro de if/laco)
  vEstMAnt := vEstM[1];
  vEstAAnt := vEstA[1];

  vEstM := 0;
  vEstA := 0;
  vSM := 0;
  vSA := 0;
  vFM := 0;
  vFA := 0;
  vPM := 0;

  if CurrentBar > PeriodoMaior + 1 then
  begin
    // ================= HORIZONTE MAIOR =================
    // agressao: N candles fechados + candle atual com o seu peso
    vSBM := Summation(vBuy,  PeriodoMaior + 1) - (1 - vPeso) * vBuy;
    vSSM := Summation(vSell, PeriodoMaior + 1) - (1 - vPeso) * vSell;
    if (vSBM + vSSM) > 0 then
      vFM := (vSBM - vSSM) / (vSBM + vSSM);

    // eficiencia do deslocamento
    vPathM := Summation(vMove, PeriodoMaior) - vMove + Abs(vClose - vFechAnt);
    if vPathM > 0 then
      vDM := (vClose - vRefM) / vPathM
    else
      vDM := 0;

    // posicao no range
    vHHM := Highest(High, PeriodoMaior + 1);
    vLLM := Lowest(Low, PeriodoMaior + 1);
    if vHHM > vLLM then
      vPM := 2 * (vClose - vLLM) / (vHHM - vLLM) - 1
    else
      vPM := 0;

    // estrutura dos candles
    vCM := (Summation(vCLV, PeriodoMaior + 1) - (1 - vPeso) * vCLV) / (PeriodoMaior + vPeso);

    // trava cada componente entre -1 e +1 (protecao contra dado ruim)
    vFM := Max(-1, Min(1, vFM));
    vDM := Max(-1, Min(1, vDM));
    vPM := Max(-1, Min(1, vPM));
    vCM := Max(-1, Min(1, vCM));

    vSM := (vDM + vPM + vCM) / 3;

    // ================= HORIZONTE ATUAL =================
    vSBA := Summation(vBuy,  PeriodoAtual + 1) - (1 - vPeso) * vBuy;
    vSSA := Summation(vSell, PeriodoAtual + 1) - (1 - vPeso) * vSell;
    if (vSBA + vSSA) > 0 then
      vFA := (vSBA - vSSA) / (vSBA + vSSA);

    vPathA := Summation(vMove, PeriodoAtual) - vMove + Abs(vClose - vFechAnt);
    if vPathA > 0 then
      vDA := (vClose - vRefA) / vPathA
    else
      vDA := 0;

    vHHA := Highest(High, PeriodoAtual + 1);
    vLLA := Lowest(Low, PeriodoAtual + 1);
    if vHHA > vLLA then
      vPA := 2 * (vClose - vLLA) / (vHHA - vLLA) - 1
    else
      vPA := 0;

    vCA := (Summation(vCLV, PeriodoAtual + 1) - (1 - vPeso) * vCLV) / (PeriodoAtual + vPeso);

    vFA := Max(-1, Min(1, vFA));
    vDA := Max(-1, Min(1, vDA));
    vPA := Max(-1, Min(1, vPA));
    vCA := Max(-1, Min(1, vCA));

    vSA := (vDA + vPA + vCA) / 3;

    // ================= ESTADOS COM HISTERESE =================
    // movimento maior
    if vEstMAnt = 1 then
    begin
      if vSM >= LimiteSaida then vEstM := 1
      else if vSM <= -LimiteEntrada then vEstM := -1
      else vEstM := 0;
    end
    else if vEstMAnt = -1 then
    begin
      if vSM <= -LimiteSaida then vEstM := -1
      else if vSM >= LimiteEntrada then vEstM := 1
      else vEstM := 0;
    end
    else
    begin
      if vSM >= LimiteEntrada then vEstM := 1
      else if vSM <= -LimiteEntrada then vEstM := -1
      else vEstM := 0;
    end;

    // movimento atual
    if vEstAAnt = 1 then
    begin
      if vSA >= LimiteSaida then vEstA := 1
      else if vSA <= -LimiteEntrada then vEstA := -1
      else vEstA := 0;
    end
    else if vEstAAnt = -1 then
    begin
      if vSA <= -LimiteSaida then vEstA := -1
      else if vSA >= LimiteEntrada then vEstA := 1
      else vEstA := 0;
    end
    else
    begin
      if vSA >= LimiteEntrada then vEstA := 1
      else if vSA <= -LimiteEntrada then vEstA := -1
      else vEstA := 0;
    end;
  end;

  // ---------------- leituras qualitativas ----------------
  // correcao x virada (so quando o atual vai contra o maior)
  // 0 = sem conflito, 1 = correcao, 2 = possivel virada
  vLeitura := 0;
  if (vEstM = 1) and (vEstA = -1) then
  begin
    if (vPM < 0) and (vFA <= -LimiteAgressao) then vLeitura := 2
    else vLeitura := 1;
  end
  else if (vEstM = -1) and (vEstA = 1) then
  begin
    if (vPM > 0) and (vFA >= LimiteAgressao) then vLeitura := 2
    else vLeitura := 1;
  end;

  // agressao x preco: 0 neutra, 1 confirma, 2 absorvida / sem resultado
  vAgr := 0;
  if (vFM >= LimiteAgressao) or (vFM <= -LimiteAgressao) then
  begin
    if ((vFM > 0) and (vSM >= LimiteSaida)) or ((vFM < 0) and (vSM <= -LimiteSaida)) then
      vAgr := 1
    else
      vAgr := 2;
  end;

  // ---------------- janela do indicador ----------------
  // Plot 1: placar do movimento maior, histograma grosso
  //         verde = comprador, vermelho = vendedor, cinza = disputa
  Plot(vSM * 100);
  SetPlotType(1, 1);
  SetPlotWidth(1, 4);
  if vEstM = 1 then SetPlotColor(1, clLime)
  else if vEstM = -1 then SetPlotColor(1, clRed)
  else SetPlotColor(1, clCinza);

  // Plot 2: placar do movimento atual (1 hora), linha branca
  Plot2(vSA * 100);
  SetPlotColor(2, clBranco);
  SetPlotWidth(2, 2);

  // Plot 3: saldo de agressao (4 horas), linha fina
  //         azul = confirma o preco, amarelo = absorvida / sem resultado
  Plot3(vFM * 100);
  SetPlotWidth(3, 1);
  if vAgr = 1 then SetPlotColor(3, clAqua)
  else if vAgr = 2 then SetPlotColor(3, clAmarelo)
  else SetPlotColor(3, clCinza);

  // Plots 4 e 5: linhas de referencia do limite de entrada (+30 / -30)
  // tambem garantem que a escala da janela mostre pelo menos essa faixa
  Plot4(LimiteEntrada * 100);
  Plot5(-LimiteEntrada * 100);
  SetPlotColor(4, clCinzaEscuro);
  SetPlotColor(5, clCinzaEscuro);
  SetPlotStyle(4, 2);
  SetPlotStyle(5, 2);
  SetPlotWidth(4, 1);
  SetPlotWidth(5, 1);

  // Plots 6 e 7: ancoras fixas em +100 / -100 (escala maxima do placar).
  // Mantem a escala da janela sempre de -100 a +100, para o grafico nao
  // "achatar" nem mudar de tamanho quando voce rola ou muda o zoom.
  Plot6(100);
  Plot7(-100);
  SetPlotColor(6, clAzulMarinho);
  SetPlotColor(7, clAzulMarinho);
  SetPlotWidth(6, 1);
  SetPlotWidth(7, 1);

  if PintarCandles then
  begin
    if vEstM = 1 then PaintBar(clLime)
    else if vEstM = -1 then PaintBar(clRed);
  end;

  // ---------------- texto (opcional, so no ultimo candle) ----------------
  // O PlotText e o unico elemento que so existe no ultimo candle. Com ele
  // ligado, a escala da janela quebrava sempre que o candle do dia ficava
  // visivel na tela. Por isso vem desligado.
  if MostrarTexto and LastBarOnChart then
  begin
    vCompra := 50 + 50 * vSM;
    vVenda  := 100 - vCompra;

    if vEstM = 1 then
    begin
      if vLeitura = 2 then
        PlotText("COMPRADOR " + FloatToString(vCompra, 0) + "% - POSSIVEL VIRADA P/ VENDA",
                 clAmarelo, 3, 10, 85)
      else if vLeitura = 1 then
        PlotText("COMPRADOR " + FloatToString(vCompra, 0) + "% - correcao vendedora",
                 clLime, 3, 10, 85)
      else
        PlotText("COMPRADOR " + FloatToString(vCompra, 0) + "%",
                 clLime, 3, 10, 85);
    end
    else if vEstM = -1 then
    begin
      if vLeitura = 2 then
        PlotText("VENDEDOR " + FloatToString(vVenda, 0) + "% - POSSIVEL VIRADA P/ COMPRA",
                 clAmarelo, 3, 10, 85)
      else if vLeitura = 1 then
        PlotText("VENDEDOR " + FloatToString(vVenda, 0) + "% - correcao compradora",
                 clRed, 3, 10, 85)
      else
        PlotText("VENDEDOR " + FloatToString(vVenda, 0) + "%",
                 clRed, 3, 10, 85);
    end
    else
      PlotText("DISPUTA  compra " + FloatToString(vCompra, 0) + "% x venda " +
               FloatToString(vVenda, 0) + "%", clCinza, 3, 10, 85);
  end;
end;
