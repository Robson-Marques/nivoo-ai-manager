// =====================================================================
// Pavio Longo de Rejeicao 15m + 5m (Topo e Fundo)
// APLICAR EM GRAFICO DE 5 MINUTOS.
//
// Monta o candle de 15 min com os 3 candles de 5 min de cada bloco
// (:00, :15, :30, :45). A marca sai no candle de 5 min que FECHA o 15m
// (:10, :25, :40, :55) e esse proprio candle e a rejeicao:
//
//   FUNDO: o candle de 5m que fecha o bloco e VENDEDOR (fecha abaixo da
//          abertura), tem pavio inferior longo e fez a minima do 15m;
//          e o candle de 15m tambem e VENDEDOR com pavio inferior longo.
//   TOPO:  o mesmo ao contrario: candles COMPRADORES com pavio superior
//          longo, e o 5m fez a maxima do 15m.
//
// "Pavio longo" (vale para o 15m e para o 5m, cada um no seu tempo):
//   1. Pavio >= PercPavio % do candle inteiro (maxima - minima)
//   2. Pavio >= MultCorpo x o corpo
//   3. Pavio >= MultPavioOposto x o pavio do lado contrario
//   4. Pavio >= MultMedia x a amplitude media dos ultimos PeriodoMedia
//      candles daquele tempo grafico
//   5. (so no 15m, opcional) o 15m fez a menor minima / maior maxima dos
//      ultimos PeriodoContexto candles de 15m. 0 = desliga.
// =====================================================================

input
  PercPavio(50.0);        // pavio minimo em % do candle inteiro
  MultCorpo(2.0);         // pavio minimo em vezes o corpo
  MultPavioOposto(2.0);   // pavio minimo em vezes o pavio do outro lado
  MultMedia(0.6);         // pavio minimo em vezes a amplitude media
  PeriodoMedia(20);       // candles para a amplitude media
  PeriodoContexto(5);     // candles de 15m para exigir nova min/max (0 = desliga)
  PintarCandle(true);     // pinta o candle de rejeicao
  UsarAlerta(true);       // alerta quando o 15m fecha com sinal

var
  vCorpo5, vAmp5, vPavSup5, vPavInf5, vMedia5 : Float;
  bFundo5, bTopo5        : Boolean;
  vHora, vMinuto, vPos   : Integer;
  vBloco                 : Integer;
  vAbe15, vMax15, vMin15 : Float;
  vCorpo15, vAmp15, vPavSup15, vPavInf15 : Float;
  vMedia15               : Float;
  vSinalFundo, vSinalTopo : Integer;
  bNovoBloco, bFimBloco, bCtxF, bCtxT : Boolean;

begin
  // ---------------- 5 minutos: o candle atual ----------------
  vCorpo5  := Abs(Close - Open);
  vAmp5    := High - Low;
  vPavSup5 := High - Max(Open, Close);
  vPavInf5 := Min(Open, Close) - Low;
  vMedia5  := Media(PeriodoMedia, High) - Media(PeriodoMedia, Low);

  // fundo: candle VENDEDOR com pavio inferior longo
  bFundo5 := (vAmp5 > 0) and (Close < Open)
             and (vPavInf5 >= vAmp5 * PercPavio / 100)
             and (vPavInf5 >= vCorpo5 * MultCorpo)
             and (vPavInf5 >= vPavSup5 * MultPavioOposto)
             and (vPavInf5 >= vMedia5 * MultMedia);

  // topo: candle COMPRADOR com pavio superior longo
  bTopo5  := (vAmp5 > 0) and (Close > Open)
             and (vPavSup5 >= vAmp5 * PercPavio / 100)
             and (vPavSup5 >= vCorpo5 * MultCorpo)
             and (vPavSup5 >= vPavInf5 * MultPavioOposto)
             and (vPavSup5 >= vMedia5 * MultMedia);

  // ---------------- monta o candle de 15 minutos ----------------
  vHora   := Floor(Time / 100);
  vMinuto := Time - vHora * 100;
  vBloco  := vHora * 4 + Floor(vMinuto / 15);
  vPos    := Mod(vMinuto, 15);
  bFimBloco := (vPos = 10);          // candle de 5m que fecha o 15m

  if CurrentBar <= 1 then
    bNovoBloco := true
  else
    bNovoBloco := (Date <> Date[1]) or (vBloco <> vBloco[1]);

  if bNovoBloco then
  begin
    vAbe15 := Open;
    vMax15 := High;
    vMin15 := Low;
  end
  else
  begin
    vAbe15 := vAbe15[1];
    vMax15 := Max(vMax15[1], High);
    vMin15 := Min(vMin15[1], Low);
  end;

  vAmp15    := vMax15 - vMin15;
  vCorpo15  := Abs(Close - vAbe15);
  vPavSup15 := vMax15 - Max(vAbe15, Close);
  vPavInf15 := Min(vAbe15, Close) - vMin15;

  // amplitude media dos candles de 15m (media exponencial, so nos fechamentos)
  if CurrentBar <= 1 then
    vMedia15 := 0
  else
    vMedia15 := vMedia15[1];

  vSinalFundo := 0;
  vSinalTopo  := 0;

  if bFimBloco and (vAmp15 > 0) then
  begin
    if (CurrentBar > PeriodoMedia * 3) and (vMedia15 > 0) then
    begin
      bCtxF := true;
      bCtxT := true;
      if PeriodoContexto > 0 then
      begin
        bCtxF := vMin15 <= Lowest(Low, PeriodoContexto * 3);
        bCtxT := vMax15 >= Highest(High, PeriodoContexto * 3);
      end;

      // FUNDO: este 5m e vendedor com pavio inferior longo e fez a minima
      // do 15m; o 15m tambem e vendedor com pavio inferior longo
      if bCtxF and bFundo5 and (Low <= vMin15) and (Close < vAbe15)
         and (vPavInf15 >= vAmp15 * PercPavio / 100)
         and (vPavInf15 >= vCorpo15 * MultCorpo)
         and (vPavInf15 >= vPavSup15 * MultPavioOposto)
         and (vPavInf15 >= vMedia15 * MultMedia) then
        vSinalFundo := 1;

      // TOPO: este 5m e comprador com pavio superior longo e fez a maxima
      // do 15m; o 15m tambem e comprador com pavio superior longo
      if bCtxT and bTopo5 and (High >= vMax15) and (Close > vAbe15)
         and (vPavSup15 >= vAmp15 * PercPavio / 100)
         and (vPavSup15 >= vCorpo15 * MultCorpo)
         and (vPavSup15 >= vPavInf15 * MultPavioOposto)
         and (vPavSup15 >= vMedia15 * MultMedia) then
        vSinalTopo := 1;
    end;

    // atualiza a media de 15m depois de usar a anterior
    if vMedia15 = 0 then
      vMedia15 := vAmp15
    else
      vMedia15 := vMedia15 + (vAmp15 - vMedia15) * 2 / (PeriodoMedia + 1);
  end;

  // ---------------- marcas no grafico ----------------
  if vSinalFundo = 1 then
  begin
    PlotText("FUNDO", clLime, 0, 9);
    if PintarCandle then PaintBar(clLime);
  end;

  if vSinalTopo = 1 then
  begin
    PlotText("TOPO", clRed, 2, 9);
    if PintarCandle then PaintBar(clRed);
  end;

  if LastBarOnChart and (GraphicOffset <> 5) then
    PlotText("USE NO GRAFICO DE 5 MINUTOS", clYellow, 2, 10);

  // alerta com o candle de 15m ja fechado
  if UsarAlerta and (CurrentBar > 2) then
  begin
    if vSinalFundo[1] = 1 then Alert(clLime);
    if vSinalTopo[1]  = 1 then Alert(clRed);
  end;
end;
